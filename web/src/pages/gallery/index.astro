---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { sfetch, img, formatData } from '../../lib/sanity';
import { albumListQuery } from '../../lib/queries';

const album = await sfetch<any[]>(albumListQuery, {}, []);
---
<Layout title="Gallery">
  <PageHero eyebrow="Immagini" title="Gallery" lead="Le foto delle partite e degli eventi della stagione." />
  <section class="section">
    <div class="container">
      {album.length ? (
        <div class="grid cols-3">
          {album.map((a) => {
            const cover = img(a.copertina, 640, 460);
            return (
              <div class="card album">
                <div class="ph">
                  {cover ? <img src={cover} alt={a.titolo} loading="lazy" /> : <div class="ph-empty" aria-hidden="true"></div>}
                  {a.conteggio > 0 && <span class="count">{a.conteggio} foto</span>}
                </div>
                <div class="body"><h3>{a.titolo}</h3><span class="tag">{formatData(a.data)}</span></div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="empty"><strong>Nessun album pubblicato</strong>Gli album fotografici inseriti nel pannello appariranno qui.</div>
      )}
    </div>
  </section>
</Layout>
<style>
  .album { display: flex; flex-direction: column; }
  .ph { position: relative; aspect-ratio: 4 / 3; background: var(--surface-2); overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .ph-empty { width: 100%; height: 100%; background: linear-gradient(180deg, var(--surface-2), var(--surface)); }
  .count { position: absolute; bottom: 10px; right: 10px; background: rgba(20,16,17,.72); color: #fff; font-size: .72rem;
    font-weight: 600; padding: .25rem .55rem; border-radius: 999px; }
  .album .body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 3px; }
</style>
