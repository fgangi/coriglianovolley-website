---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import { sfetch, img } from '../../lib/sanity';
import { giovaniliQuery, newsListQuery, settingsQuery } from '../../lib/queries';

const [squadre, news, settings] = await Promise.all([
  sfetch<any[]>(giovaniliQuery, {}, []),
  sfetch<any[]>(newsListQuery, { settore: 'giovanile', limit: 6 }, []),
  sfetch<any>(settingsQuery, {}, null),
]);

// La sezione compare solo a iscrizioni aperte e con il modulo compilato:
// un pulsante che porta a un modulo chiuso è peggio di nessun pulsante.
const isc = settings?.iscrizioni ?? {};
const iscrizioniAttive = isc.aperte !== false && !!isc.moduloUrl;
const categorie: string[] = isc.categorie ?? [];

// Tre blocchi, nell'ordine FIPAV: prima il minivolley, poi femminile e maschile.
// Un gruppo senza settore (inserito prima che il campo esistesse) va in fondo.
const SETTORI = [
  { id: 'minivolley', label: 'Minivolley - S3', genere: '' },
  { id: 'femminile', label: 'Femminile', genere: 'Femminile' },
  { id: 'maschile', label: 'Maschile', genere: 'Maschile' },
];
const settori = [
  ...SETTORI.map((st) => ({ ...st, squadre: squadre.filter((sq) => sq.settore === st.id) })),
  { id: 'altri', label: 'Altri gruppi', genere: '', squadre: squadre.filter((sq) => !SETTORI.some((st) => st.id === sq.settore)) },
].filter((st) => st.squadre.length > 0);
// Nel pannello il nome è completo ("Under 14 Femminile"); dentro il blocco
// Femminile ripeterlo cinque volte non aggiunge nulla, quindi si toglie.
const breve = (nome: string, genere: string) =>
  genere ? nome.replace(new RegExp(`\\s+${genere}$`, 'i'), '') : nome;
---
<Layout title="Settore giovanile" description="Il settore giovanile della Corigliano Volley: corsi di minivolley e pallavolo maschile e femminile, iscrizioni e notizie del vivaio.">
  <PageHero eyebrow="Il vivaio" title="Settore giovanile" lead="Le squadre del nostro vivaio, le iscrizioni ai corsi e le notizie che le riguardano." />

  {iscrizioniAttive && (
    <section class="section iscrizioni-sezione" data-sim="iscrizioni">
      <div class="container">
        <div class="iscrizioni card" id="iscrizioni">
          <div class="isc-testo">
            <span class="pill">Iscrizioni aperte</span>
            <h2>{isc.titolo ?? 'Iscriviti al settore giovanile'}</h2>
            {isc.testo && <p>{isc.testo}</p>}
            {categorie.length > 0 && (
              <ul class="isc-categorie">
                {categorie.map((c) => <li>{c}</li>)}
              </ul>
            )}
          </div>
          <div class="isc-azione">
            <a class="btn primary grande" href={isc.moduloUrl} target="_blank" rel="noopener">Compila il modulo →</a>
            {isc.nota && <span class="isc-nota">{isc.nota}</span>}
            <span class="isc-nota">Il modulo si apre in una nuova scheda.</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* La sezione compare solo quando ci sono gruppi inseriti: senza squadre
      mostrava un segnaposto vuoto. Aggiungendole nel pannello ricompare.
      I gruppi sono divisi in tre blocchi, dal campo "Settore" del pannello. */}
  {squadre.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head" id="gruppi"><span class="eyebrow">Le squadre</span><h2>I nostri gruppi</h2></div>
        <div class="settori">
          {settori.map((st) => (
            <div class="settore">
              <h3 class="liv-title">{st.label}</h3>
              <ul class="gruppi">
                {st.squadre.map((sq) => {
                  const foto = img(sq.foto, 640, 400);
                  return (
                    <li class="card gruppo">
                      {foto && <div class="ph"><img src={foto} alt={sq.nome} loading="lazy" /></div>}
                      <div class="body">
                        <h4>{breve(sq.nome, st.genere)}</h4>
                        {sq.campionato && <span class="tag">{sq.campionato}</span>}
                        {sq.descrizione && <p>{sq.descrizione}</p>}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head between" id="news-vivaio">
        <div><span class="eyebrow">Aggiornamenti</span><h2>News del vivaio</h2></div>
      </div>
      {news.length ? (
        <div class="grid cols-3">{news.map((n) => <NewsCard item={n} />)}</div>
      ) : (
        <div class="empty"><strong>Nessuna notizia del settore giovanile</strong>Le notizie con sezione “Settore giovanile” appariranno qui.</div>
      )}
    </div>
  </section>
</Layout>
<style>
  /* Blocco iscrizioni: testo a sinistra, azione a destra; su schermi
     stretti diventa una colonna sola con il pulsante a tutta larghezza. */
  .iscrizioni { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px); align-items: center; padding: clamp(22px, 3vw, 36px); }
  .isc-testo { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .isc-testo h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .isc-testo p { color: var(--ink-soft); }
  .isc-categorie { list-style: none; margin: 2px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 7px; }
  .isc-categorie li { font-size: .82rem; font-weight: 650; color: var(--ink-soft);
    background: var(--surface-2); border-radius: 999px; padding: .28rem .66rem; }
  .isc-azione { display: flex; flex-direction: column; align-items: stretch; gap: 10px; }
  .btn.grande { justify-content: center; padding: .85rem 1.3rem; font-size: 1rem; }
  .isc-nota { font-size: .8rem; color: var(--ink-faint); text-align: center; }
  @media (max-width: 860px) { .iscrizioni { grid-template-columns: minmax(0, 1fr); align-items: start; } }

  /* PC: i tre blocchi affiancati; tablet e telefono: uno sotto l'altro, con
     i gruppi su tre colonne (due sul telefono): i nomi sono corti, una
     colonna sola sprecherebbe metà schermo. */
  .settori { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 40px); align-items: start; }
  .gruppi { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .gruppo { display: flex; flex-direction: column; overflow: hidden; }
  .gruppo .body { padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; }
  .gruppo h4 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; line-height: 1.15; margin: 0; }
  .gruppo .body p { font-size: .92rem; }
  .ph { aspect-ratio: 16 / 10; background: var(--surface-2); overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1023px) {
    .settori { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .gruppi { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) { .gruppi { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .liv-title { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
</style>
