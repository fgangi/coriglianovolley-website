---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import { sfetch, img } from '../../lib/sanity';
import { giovaniliQuery, newsListQuery } from '../../lib/queries';

const [squadre, news] = await Promise.all([
  sfetch<any[]>(giovaniliQuery, {}, []),
  sfetch<any[]>(newsListQuery, { settore: 'giovanile', limit: 6 }, []),
]);
---
<Layout title="Settore giovanile">
  <PageHero eyebrow="Il vivaio" title="Settore giovanile" lead="Le squadre del nostro vivaio e le notizie che le riguardano." />

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Le squadre</span><h2>I nostri gruppi</h2></div>
      {squadre.length ? (
        <div class="grid cols-3">
          {squadre.map((sq) => {
            const foto = img(sq.foto, 640, 400);
            return (
              <div class="card team-card">
                <div class="ph">{foto ? <img src={foto} alt={sq.nome} loading="lazy" /> : <div class="ph-empty" aria-hidden="true"></div>}</div>
                <div class="body">
                  <h3>{sq.nome}</h3>
                  {sq.campionato && <span class="tag">{sq.campionato}</span>}
                  {sq.descrizione && <p>{sq.descrizione}</p>}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="empty"><strong>Squadre non ancora inserite</strong>I gruppi del settore giovanile aggiunti nel pannello appariranno qui.</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Aggiornamenti</span><h2>News del vivaio</h2></div>
      </div>
      {news.length ? (
        <div class="grid cols-3">{news.map((n) => <NewsCard item={n} />)}</div>
      ) : (
        <div class="empty"><strong>Nessuna notizia del settore giovanile</strong>Le notizie con sezione “Settore giovanile” appariranno qui.</div>
      )}
    </div>
  </section>
</Layout>
<style>
  .team-card { display: flex; flex-direction: column; }
  .ph { aspect-ratio: 16 / 10; background: var(--surface-2); overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .ph-empty { width: 100%; height: 100%; background: linear-gradient(180deg, var(--surface-2), var(--surface)); }
  .team-card .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; }
  .team-card .body p { font-size: .92rem; }
</style>
