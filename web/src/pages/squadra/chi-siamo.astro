---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import RosterGrid from '../../components/RosterGrid.astro';
import StaffGrid from '../../components/StaffGrid.astro';
import { sfetch, img, richText } from '../../lib/sanity';
import { settingsQuery, rosterQuery, staffQuery } from '../../lib/queries';

const [settings, roster, staff] = await Promise.all([
  sfetch<any>(settingsQuery, {}, null),
  sfetch<any[]>(rosterQuery, {}, []),
  sfetch<any[]>(staffQuery, {}, []),
]);
const storiaHtml = richText(settings?.storia);
const fotoSquadra = img(settings?.fotoSquadra, 1400);
const nome = settings?.nomeSquadra ?? 'Corigliano Volley';
---
<Layout title="Chi siamo" description={`La storia e i valori di ${nome}.`}>
  <PageHero eyebrow="La società" title="Chi siamo" lead={`Storia, valori e persone di ${nome}.`} />

  {fotoSquadra && (
    <div class="container team-photo">
      <img src={fotoSquadra} alt={`Foto di squadra ${nome}`} />
    </div>
  )}

  <!-- LA NOSTRA STORIA -->
  <section class="section">
    <div class="container narrow">
      <div class="section-head"><span class="eyebrow">Le origini</span><h2>La nostra storia</h2></div>
      {storiaHtml ? (
        <div class="prose" set:html={storiaHtml} />
      ) : (
        <div class="prose">
          <p class="lead">Il ritorno in Serie A3 è il traguardo di un progetto sportivo che affonda le radici nella nostra città e nella passione di tutta la comunità.</p>
          <p class="muted">Questo testo è provvisorio: la storia della società può essere inserita dal pannello, alla voce “Impostazioni sito → La nostra storia”.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ROSTER -->
  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">In campo</span><h2>La squadra</h2></div>
        <a class="btn" href="/squadra">Vai alla sezione squadra</a>
      </div>
      <RosterGrid roster={roster} />
    </div>
  </section>

  <!-- STAFF -->
  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Organigramma</span><h2>Staff tecnico e medico</h2></div>
      <StaffGrid staff={staff} aree={['tecnico', 'medico']} vuoto="Staff non ancora inserito" />
    </div>
  </section>

  <!-- PRESIDENZA E DIRIGENZA -->
  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">La società</span><h2>Organigramma</h2></div>
      <StaffGrid staff={staff} aree={['presidenza', 'dirigenza']} vuoto="Organigramma non ancora inserito" />
    </div>
  </section>
</Layout>
<style>
  .team-photo { margin-top: clamp(24px, 4vw, 40px); }
  .team-photo img { width: 100%; border-radius: var(--radius); border: 1px solid var(--line); }
  .prose { display: flex; flex-direction: column; gap: 1.05rem; font-size: 1.05rem; line-height: 1.75; }
  .prose :global(h2) { font-size: 1.5rem; margin-top: 1rem; }
  .prose :global(h3) { font-size: 1.2rem; margin-top: .6rem; }
  .prose :global(p) { color: var(--ink-soft); }
  .prose :global(a) { color: var(--accent); text-decoration: underline; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 16px; color: var(--ink-soft); font-style: italic; margin: 0; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--line); }
  .prose :global(ul), .prose :global(ol) { color: var(--ink-soft); padding-left: 1.3rem; display: flex; flex-direction: column; gap: .4rem; }
</style>
