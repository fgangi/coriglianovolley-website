---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import RosterGrid from '../../components/RosterGrid.astro';
import StaffGrid from '../../components/StaffGrid.astro';
import { sfetch, img } from '../../lib/sanity';
import { rosterQuery, staffQuery, settingsQuery } from '../../lib/queries';

const [roster, staff, settings] = await Promise.all([
  sfetch<any[]>(rosterQuery, {}, []),
  sfetch<any[]>(staffQuery, {}, []),
  sfetch<any>(settingsQuery, {}, null),
]);
const fotoSquadra = img(settings?.fotoSquadra, 1400);
const stagione = settings?.stagione;
---
<Layout title="La squadra" description="Il roster e lo staff della prima squadra.">
  <PageHero
    eyebrow="Prima squadra"
    title="La squadra"
    lead={stagione ? `Giocatori e staff della stagione ${stagione}.` : 'Giocatori e staff della prima squadra.'}
  />

  {fotoSquadra && (
    <div class="container team-photo">
      <img src={fotoSquadra} alt={`Foto di squadra ${settings?.nomeSquadra ?? ''}`} />
    </div>
  )}

  <section class="section" id="roster" style="scroll-margin-top: 110px;">
    <div class="container">
      <div class="section-head"><span class="eyebrow">In campo</span><h2>Roster</h2></div>
      <RosterGrid roster={roster} />
    </div>
  </section>

  <section class="section" id="staff" style="scroll-margin-top: 110px;">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Dietro le quinte</span><h2>Staff</h2></div>
      <StaffGrid staff={staff} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <a class="btn" href="/squadra/chi-siamo">Scopri la nostra storia →</a>
    </div>
  </section>
</Layout>
<style>
  .team-photo { margin-top: clamp(24px, 4vw, 40px); }
  .team-photo img { width: 100%; border-radius: var(--radius); border: 1px solid var(--line); }
</style>
