---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import PartitaRow from '../components/PartitaRow.astro';
import Carousel from '../components/Carousel.astro';
import { sfetch, img, formatData } from '../lib/sanity';
import {
  settingsQuery, risultatiQuery, prossimePartiteQuery,
  newsInEvidenzaQuery, newsListQuery, sponsorQuery, rosterQuery, staffQuery,
} from '../lib/queries';

const settings = await sfetch<any>(settingsQuery, {}, null);
const [risultati, prossime, evidenza, ultime, sponsor, roster, staff] = await Promise.all([
  sfetch<any[]>(risultatiQuery, { limit: 3 }, []),
  sfetch<any[]>(prossimePartiteQuery, { limit: 3 }, []),
  sfetch<any[]>(newsInEvidenzaQuery, {}, []),
  sfetch<any[]>(newsListQuery, { settore: 'prima-squadra', limit: 3 }, []),
  sfetch<any[]>(sponsorQuery, {}, []),
  sfetch<any[]>(rosterQuery, {}, []),
  sfetch<any[]>(staffQuery, {}, []),
]);
const featured = evidenza[0] ?? null;
const featuredCover = featured ? img(featured.copertina, 1000, 640) : null;
// L'elenco "Ultime news" esclude la notizia già mostrata in evidenza.
const latest = ultime.filter((n) => n._id !== featured?._id).slice(0, 3);
const prossima = settings?.prossimaPartita ?? prossime[0] ?? null;
const nome = settings?.nomeSquadra ?? 'Corigliano Volley';
// Logo Mikasa (pallone ufficiale) — il logo Lega/Credem è ora nell'header
const lega = settings?.loghiLega ?? {};
const mikasaLogo = img(lega.mikasaLogo, 320);
// Sponsor in home ordinati per importanza (la query li ordina alfabeticamente)
const RANK_SPONSOR: Record<string, number> = { main: 0, gold: 1, silver: 2, bronze: 3, partner: 4, media: 5 };
const sponsorOrdinati = [...sponsor].sort(
  (a, b) => (RANK_SPONSOR[a.livello] ?? 9) - (RANK_SPONSOR[b.livello] ?? 9)
);
// Anteprime che rimandano alle sezioni dedicate
const prossimeList = prossime.slice(0, 3);
const direttaLink = prossime.find((m) => m.direttaUrl)?.direttaUrl ?? settings?.direttaUrl ?? null;
const rosterPreview = roster;
// Nei caroselli in home scorre tutto: roster completo e staff ordinato per area
const RANK_AREA: Record<string, number> = { tecnico: 0, medico: 1, dirigenza: 2 };
const staffPreview = [...staff].sort(
  (a, b) => (RANK_AREA[a.area ?? 'tecnico'] ?? 9) - (RANK_AREA[b.area ?? 'tecnico'] ?? 9)
);
const RUOLI_LABEL: Record<string, string> = { palleggiatore: 'Palleggiatore', opposto: 'Opposto', schiacciatore: 'Schiacciatore', centrale: 'Centrale', libero: 'Libero' };
---
<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="pill">Serie A3 Maschile{settings?.stagione ? ` · ${settings.stagione}` : ''}</span>
        <h1>{nome}</h1>
        <p class="lead">La casa ufficiale della nostra squadra: risultati, calendario, roster, news e settore giovanile. Forza ragazzi.</p>
        <div class="hero-cta">
          <a class="btn primary" href="/partite">Calendario &amp; risultati</a>
          {direttaLink && <a class="btn live" href="/partite#diretta"><span class="live-dot" aria-hidden="true"></span>Guarda la diretta</a>}
          <a class="btn ghost" href="/squadra">Conosci la squadra</a>
        </div>
      </div>
      {prossima && (
        <aside class="next-match card">
          <span class="eyebrow">Prossima partita</span>
          <div class="nm-team">{prossima.dove === 'casa' ? nome : prossima.avversario}</div>
          <div class="nm-vs">vs</div>
          <div class="nm-team">{prossima.dove === 'casa' ? prossima.avversario : nome}</div>
          <div class="nm-when">{formatData(prossima.data, true)}</div>
          {prossima.luogo && <div class="nm-where">{prossima.dove === 'casa' ? '🏠' : '✈️'} {prossima.luogo}</div>}
        </aside>
      )}
    </div>
  </section>

  <!-- PROSSIME PARTITE -->
  {prossimeList.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">In arrivo</span><h2>Prossime partite</h2></div>
          <a class="btn" href="/partite">Calendario completo</a>
        </div>
        <div class="grid cols-3">{prossimeList.map((m) => <PartitaRow m={m} />)}</div>
      </div>
    </section>
  )}

  <!-- RISULTATI -->
  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Campo</span><h2>Ultimi risultati</h2></div>
        <a class="btn" href="/partite">Tutte le partite</a>
      </div>
      {risultati.length ? (
        <div class="grid cols-3">{risultati.map((m) => <PartitaRow m={m} />)}</div>
      ) : (
        <div class="empty"><strong>Ancora nessun risultato</strong>I risultati appariranno qui dopo le prime giornate.</div>
      )}
    </div>
  </section>

  <!-- IN EVIDENZA -->
  {featured && (
    <section class="section">
      <div class="container">
        <div class="section-head"><span class="eyebrow">In evidenza</span><h2>Da non perdere</h2></div>
        <a class="featured card" href={`/news/${featured.slug}`}>
          <div class="f-media">
            {featuredCover ? <img src={featuredCover} alt={featured.titolo} /> : <div class="thumb-ph" aria-hidden="true"></div>}
          </div>
          <div class="f-body">
            <span class="pill">In evidenza</span>
            <span class="tag">{formatData(featured.data)}</span>
            <h3>{featured.titolo}</h3>
            {featured.estratto && <p>{featured.estratto}</p>}
            <span class="more">Leggi l'articolo →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ULTIME NEWS -->
  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Aggiornamenti</span><h2>Ultime news</h2></div>
        <a class="btn" href="/news">Tutte le news</a>
      </div>
      {latest.length ? (
        <div class="grid cols-3">{latest.map((n) => <NewsCard item={n} />)}</div>
      ) : featured ? (
        <div class="empty"><strong>Nessun'altra notizia</strong>Pubblica altre news nel pannello per riempire questa sezione.</div>
      ) : (
        <div class="empty"><strong>Nessuna notizia pubblicata</strong>Le notizie inserite nel pannello appariranno qui.</div>
      )}
    </div>
  </section>

  <!-- ROSTER (anteprima) -->
  {rosterPreview.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">La squadra</span><h2>La rosa</h2></div>
          <a class="btn" href="/squadra#roster">Vedi tutta la squadra</a>
        </div>
        <Carousel etichetta="Giocatori della rosa">
          {rosterPreview.map((p) => {
            const foto = img(p.foto, 320, 380);
            return (
              <a class="rp-card" href="/squadra#roster">
                <div class="rp-ph">
                  {foto ? <img src={foto} alt={`${p.nome} ${p.cognome}`} loading="lazy" /> : <div class="rp-empty" aria-hidden="true"></div>}
                  {p.numero != null && <span class="rp-num">{p.numero}</span>}
                </div>
                <div class="rp-info"><strong>{p.cognome}</strong><span class="tag">{RUOLI_LABEL[p.ruolo] ?? ''}</span></div>
              </a>
            );
          })}
        </Carousel>
      </div>
    </section>
  )}

  <!-- STAFF (anteprima) -->
  {staffPreview.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">Dietro le quinte</span><h2>Lo staff</h2></div>
          <a class="btn" href="/squadra#staff">Tutto lo staff</a>
        </div>
        <Carousel etichetta="Staff e dirigenza">
          {staffPreview.map((m) => {
            const foto = img(m.foto, 300, 300);
            return (
              <div class="card member-mini">
                <div class="mm-ph">{foto ? <img src={foto} alt={m.nome} loading="lazy" /> : <div class="rp-empty" aria-hidden="true"></div>}</div>
                <div class="mm-info"><strong>{m.nome}</strong><span class="tag">{m.ruolo}</span></div>
              </div>
            );
          })}
        </Carousel>
      </div>
    </section>
  )}

  <!-- SPONSOR -->
  {(sponsor.length > 0 || mikasaLogo) && (
    <section class="section">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Insieme a noi</span><h2>I nostri partner</h2></div>
        {sponsor.length > 0 && (
          <Carousel etichetta="Sponsor e partner">
            {sponsorOrdinati.map((sp) => {
              const logo = img(sp.logo, 240);
              const inner = logo ? <img src={logo} alt={sp.nome} loading="lazy" /> : <span>{sp.nome}</span>;
              return sp.url ? <a href={sp.url} target="_blank" rel="noopener" class="sp">{inner}</a> : <div class="sp">{inner}</div>;
            })}
          </Carousel>
        )}
        {mikasaLogo && (
          <div class="official-ball">
            <span class="tag">Pallone ufficiale</span>
            {lega.mikasaUrl ? (
              <a href={lega.mikasaUrl} target="_blank" rel="noopener" class="sp"><img src={mikasaLogo} alt="Mikasa" loading="lazy" /></a>
            ) : (
              <div class="sp"><img src={mikasaLogo} alt="Mikasa" loading="lazy" /></div>
            )}
          </div>
        )}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero { background: linear-gradient(180deg, var(--surface) 0%, var(--ground) 100%); border-bottom: 1px solid var(--line); }
  /* Solo padding verticale: la scorciatoia "padding: X 0" azzererebbe
     il padding orizzontale di .container, mandando l'hero a filo schermo. */
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 60px); align-items: center;
    padding-top: clamp(48px, 9vw, 110px); padding-bottom: clamp(48px, 9vw, 110px); }
  @media (max-width: 860px) { .hero-inner { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy .pill { margin-bottom: 18px; }
  .hero-copy h1 { margin: 0 0 14px; }
  .hero-copy .lead { max-width: 46ch; }
  .hero-cta { display: flex; gap: 12px; margin-top: 26px; flex-wrap: wrap; }
  .btn.live { background: var(--ink); color: #fff; border-color: transparent; }
  .btn.live:hover { background: #000; }
  .live-dot { width: .55rem; height: .55rem; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 0 0 rgba(255,59,59,.6); animation: livepulse 1.6s ease-out infinite; }
  @keyframes livepulse { 0% { box-shadow: 0 0 0 0 rgba(255,59,59,.6); } 70% { box-shadow: 0 0 0 7px rgba(255,59,59,0); } 100% { box-shadow: 0 0 0 0 rgba(255,59,59,0); } }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }
  .next-match { padding: 26px 24px; text-align: center; box-shadow: var(--shadow); }
  .next-match .eyebrow { display: block; margin-bottom: 14px; }
  .nm-team { font-size: 1.3rem; font-weight: 820; letter-spacing: -.01em; }
  .nm-vs { color: var(--ink-faint); font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; margin: 6px 0; font-weight: 700; }
  .nm-when { margin-top: 16px; font-weight: 600; color: var(--ink); }
  .nm-where { color: var(--ink-faint); font-size: .9rem; margin-top: 4px; }
  /* Schede sponsor: la larghezza la decide il carosello */
  .sp { height: 96px; display: grid; place-items: center; padding: 16px 20px; text-align: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    transition: transform .12s ease, border-color .12s ease; }
  .sp:hover { transform: translateY(-2px); border-color: var(--ink-faint); }
  .sp img { max-height: 60px; width: auto; object-fit: contain; }
  .sp span { font-weight: 700; color: var(--ink-soft); font-size: .9rem; line-height: 1.25; }

  /* Pallone ufficiale (Mikasa) */
  .official-ball { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 22px; }
  .official-ball .sp { width: 200px; }

  /* In evidenza */
  .featured { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: stretch;
    transition: transform .14s ease, border-color .14s ease; }
  .featured:hover { transform: translateY(-3px); border-color: var(--ink-faint); }
  .f-media { position: relative; background: var(--surface-2); min-height: 260px; overflow: hidden; }
  .f-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .f-media .thumb-ph { width: 100%; height: 100%;
    background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 12px, var(--surface) 12px, var(--surface) 24px); }
  .f-body { padding: clamp(22px, 3.5vw, 40px); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; justify-content: center; }
  .f-body h3 { font-size: clamp(1.3rem, 2.6vw, 1.9rem); font-weight: 800; letter-spacing: -.015em; }
  .f-body p { font-size: 1rem; }
  .f-body .more { margin-top: 6px; font-weight: 700; color: var(--accent); }
  @media (max-width: 760px) { .featured { grid-template-columns: 1fr; } .f-media { aspect-ratio: 16 / 9; min-height: 0; } }

  /* Schede giocatore nel carosello */
  .rp-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: transform .14s ease, border-color .14s ease; }
  .rp-card:hover { transform: translateY(-3px); border-color: var(--ink-faint); }
  .rp-ph { position: relative; aspect-ratio: 4 / 5; background: var(--surface-2); overflow: hidden; }
  .rp-ph img { width: 100%; height: 100%; object-fit: cover; }
  .rp-empty { width: 100%; height: 100%; background: linear-gradient(180deg, var(--surface-2), var(--surface)); }
  .rp-num { position: absolute; top: 6px; right: 8px; font-weight: 900; color: var(--accent); font-size: 1.05rem; background: var(--ground); width: 28px; height: 28px; border-radius: 7px; display: grid; place-items: center; box-shadow: var(--shadow); }
  .rp-info { padding: 10px 12px; display: flex; flex-direction: column; gap: 1px; }
  .rp-info strong { font-weight: 750; letter-spacing: -.01em; }

  /* Anteprima staff */
  .member-mini { display: flex; flex-direction: column; }
  .mm-ph { aspect-ratio: 1 / 1; background: var(--surface-2); overflow: hidden; }
  .mm-ph img { width: 100%; height: 100%; object-fit: cover; }
  .mm-info { padding: 12px 14px; display: flex; flex-direction: column; gap: 1px; }
  .mm-info strong { font-weight: 720; }
</style>
