---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import PartitaRow from '../components/PartitaRow.astro';
import Carousel from '../components/Carousel.astro';
import StrisciaSponsor from '../components/StrisciaSponsor.astro';
import { logoRifilato, misuraLogo } from '../lib/loghi';
import NewsInEvidenza from '../components/NewsInEvidenza.astro';
import Hero from '../components/Hero.astro';
import CampagnaAbbonamenti from '../components/CampagnaAbbonamenti.astro';
import { sfetch, img, formatData } from '../lib/sanity';
import {
  settingsQuery, risultatiQuery, prossimePartiteQuery,
  newsInEvidenzaQuery, newsUltimeQuery, sponsorQuery, rosterQuery, staffQuery,
} from '../lib/queries';

const settings = await sfetch<any>(settingsQuery, {}, null);
const [risultati, prossime, evidenza, ultime, sponsor, roster, staff] = await Promise.all([
  sfetch<any[]>(risultatiQuery, { limit: 3 }, []),
  sfetch<any[]>(prossimePartiteQuery, { limit: 3 }, []),
  sfetch<any[]>(newsInEvidenzaQuery, {}, []),
  // Tutte le sezioni, giovanile compreso. 4 perché una potrebbe essere
  // quella già mostrata in evidenza (viene esclusa sotto).
  sfetch<any[]>(newsUltimeQuery, { limit: 4 }, []),
  sfetch<any[]>(sponsorQuery, {}, []),
  sfetch<any[]>(rosterQuery, {}, []),
  sfetch<any[]>(staffQuery, {}, []),
]);
const featured = evidenza[0] ?? null;
// L'elenco "Ultime news" esclude la notizia già mostrata in evidenza.
const latest = ultime.filter((n) => n._id !== featured?._id).slice(0, 3);
const prossima = settings?.prossimaPartita ?? prossime[0] ?? null;
const nome = settings?.nomeSquadra ?? 'Corigliano Volley';
// Logo Mikasa (pallone ufficiale) — il logo Lega/Credem è ora nell'header
const lega = settings?.loghiLega ?? {};
const mikasaLogo = img(lega.mikasaLogo, 320);
// Sponsor divisi per categoria, nello stesso ordine della pagina Sponsor
// Le schede rimpiccioliscono a scalare: la dimensione comunica l'importanza.
/**
 * Senza riquadri il livello si legge dalla dimensione del logo. Non basta però
 * imporre la stessa altezza: un logo largo diventerebbe enorme e uno compatto
 * minuscolo. Si assegna a ciascuno la stessa SUPERFICIE, con un tetto ad
 * altezza e larghezza per i casi estremi.
 */
// L'altezza comunica il livello: scala regolare dal main al partner.
const SEZIONI_SPONSOR: { label: string; livello: string; h: number; fissa?: boolean }[] = [
  { label: 'Main sponsor', livello: 'main', h: 86 },
  { label: 'Gold sponsor', livello: 'gold', h: 72 },
  { label: 'Silver sponsor', livello: 'silver', h: 62 },
  { label: 'Bronze sponsor', livello: 'bronze', h: 54 },
  { label: 'Partner', livello: 'partner', h: 48 },
  // Lo sponsor tecnico resta fermo come la riga finale: sono pochi e fissi
  { label: 'Sponsor tecnico', livello: 'tecnico', h: 48, fissa: true },
];
const gruppiSponsor = SEZIONI_SPONSOR
  .map((s) => ({ ...s, items: sponsor.filter((x) => x.livello === s.livello) }))
  .filter((g) => g.items.length > 0);

// I loghi vengono rifilati dei margini vuoti prima di essere dimensionati:
// senza, un file con l'85% di trasparenza attorno appare la metà degli altri.
const PID = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const DS = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const loghiPronti = new Map<string, { url: string; prop: number }>();
for (const g of gruppiSponsor) {
  for (const sp of g.items) {
    const r = await logoRifilato(sp.logo, PID, DS);
    if (r) loghiPronti.set(sp._id, r);
  }
}

// Ultime categorie: una sola riga di schede piccole, ciascuna con la sua etichetta,
// invece di quattro righe separate quasi vuote.
const FINALI: { label: string; livello: string }[] = [
  { label: 'Media partner', livello: 'media' },
  { label: 'Ticketing partner', livello: 'ticketing' },
];
const H_FINALI = 48; // come i Partner: dopo quel livello non c'è più gerarchia
const grezziFinali: { label: string; nome: string; source: any; url?: string }[] = [
  ...FINALI.flatMap((f) =>
    sponsor
      .filter((x) => x.livello === f.livello)
      .map((x) => ({ label: f.label, nome: x.nome, source: x.logo, url: x.url }))
  ),
  ...(lega.mikasaLogo
    ? [{ label: 'Pallone ufficiale', nome: 'Mikasa', source: lega.mikasaLogo, url: lega.mikasaUrl }]
    : []),
];
/**
 * Anche questi passano dalla rifilatura dei margini e dalla stessa misura
 * delle righe sopra. Senza, un logo salvato con molto vuoto attorno appariva
 * la metà degli altri pur avendo la stessa altezza impostata.
 */
const sponsorFinali = await Promise.all(grezziFinali.map(async (f) => {
  const pronto = await logoRifilato(f.source, PID, DS);
  return {
    ...f,
    logo: pronto?.url ?? img(f.source, 220),
    misura: pronto ? misuraLogo(pronto.prop, H_FINALI) : undefined,
  };
}));

// Anteprime che rimandano alle sezioni dedicate
const prossimeList = prossime.slice(0, 3);
const direttaLink = prossime.find((m) => m.direttaUrl)?.direttaUrl ?? settings?.direttaUrl ?? null;
const rosterPreview = roster;
// Nei caroselli in home scorre tutto: roster completo e staff ordinato per area
const RANK_AREA: Record<string, number> = { tecnico: 0, medico: 1, presidenza: 2, dirigenza: 3 };
const staffPreview = [...staff].sort(
  (a, b) => (RANK_AREA[a.area ?? 'tecnico'] ?? 9) - (RANK_AREA[b.area ?? 'tecnico'] ?? 9)
);
/** Nelle schede ridotte mostriamo il primo incarico: chi ne ha due lo vede
 *  comunque per intero nella pagina Squadra. Evita schede disallineate senza
 *  ricorrere ai puntini di sospensione. */
const primoRuolo = (r?: string) => (r ?? '').split('·')[0].trim();
const RUOLI_LABEL: Record<string, string> = { palleggiatore: 'Palleggiatore', opposto: 'Opposto', schiacciatore: 'Schiacciatore', centrale: 'Centrale', libero: 'Libero' };
const logoUrl = img(settings?.logo, 200);
---
<Layout>
  <Hero slide={settings?.hero} />

  <!-- APERTURA: la notizia in evidenza, con la prossima partita di fianco -->
  <section class="section apertura-sezione">
    <div class="container">
      <div class="section-head"><span class="eyebrow">In evidenza</span><h2>Da non perdere</h2></div>
      <div class={prossima ? 'apertura con-partita' : 'apertura'}>
        {featured
          ? <NewsInEvidenza item={featured} />
          : <div class="empty"><strong>Nessuna notizia pubblicata</strong>La notizia in evidenza apparirà qui.</div>}

        {prossima && (
          <aside class="next-match card">
            <span class="eyebrow">Prossima partita</span>
            <div class="nm-team">{prossima.dove === 'casa' ? nome : prossima.avversario}</div>
            <div class="nm-vs">vs</div>
            <div class="nm-team">{prossima.dove === 'casa' ? prossima.avversario : nome}</div>
            <div class="nm-when">{formatData(prossima.data, true)}</div>
            {prossima.luogo && <div class="nm-where">{prossima.dove === 'casa' ? '🏠' : '✈️'} {prossima.luogo}</div>}
            <div class="nm-cta">
              {direttaLink && <a class="btn live" href="/partite/#diretta"><span class="live-dot" aria-hidden="true"></span>Guarda la diretta</a>}
              <a class="btn" href="/partite/">Calendario</a>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <CampagnaAbbonamenti campagna={settings?.campagnaAbbonamenti} />

  <!-- ULTIME NEWS -->
  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Aggiornamenti</span><h2>Ultime news</h2></div>
        <a class="btn" href="/news/">Tutte le news</a>
      </div>
      {latest.length ? (
        <div class="grid cols-3">{latest.map((n) => <NewsCard item={n} />)}</div>
      ) : featured ? (
        <div class="empty"><strong>Nessun'altra notizia</strong>Pubblica altre news nel pannello per riempire questa sezione.</div>
      ) : (
        <div class="empty"><strong>Nessuna notizia pubblicata</strong>Le notizie inserite nel pannello appariranno qui.</div>
      )}
    </div>
  </section>

  <!-- PROSSIME PARTITE: fascia rossa, come nel mockup -->
  {prossimeList.length > 0 && (
    <section class="section fascia fascia-partite">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">In arrivo</span><h2>Prossime partite</h2></div>
          <a class="btn chiaro" href="/partite/">Calendario completo</a>
        </div>
        <div class="grid cols-3">{prossimeList.map((m) => <PartitaRow m={m} logoNostro={logoUrl} />)}</div>
      </div>
    </section>
  )}

  <!-- RISULTATI -->
  <section class="section">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Campo</span><h2>Ultimi risultati</h2></div>
        <a class="btn" href="/partite/">Tutte le partite</a>
      </div>
      {risultati.length ? (
        <div class="grid cols-3">{risultati.map((m) => <PartitaRow m={m} logoNostro={logoUrl} />)}</div>
      ) : (
        <div class="empty"><strong>Ancora nessun risultato</strong>I risultati appariranno qui dopo le prime giornate.</div>
      )}
    </div>
  </section>

  <!-- ROSTER (anteprima) -->
  {rosterPreview.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">La squadra</span><h2>Il roster</h2></div>
          <a class="btn" href="/squadra/#roster">Tutta la squadra</a>
        </div>
        <Carousel etichetta="Giocatori della rosa" allinea="stretch">
          {rosterPreview.map((p) => {
            const foto = img(p.foto, 320, 380);
            return (
              <a class="rp-card" href="/squadra/#roster">
                <div class="rp-ph">
                  {foto ? <img src={foto} alt={`${p.nome} ${p.cognome}`} loading="lazy" /> : <div class="rp-empty" aria-hidden="true"></div>}
                  {p.numero != null && <span class="rp-num">{p.numero}</span>}
                </div>
                <div class="rp-info"><strong>{p.cognome}</strong><span class="tag">{RUOLI_LABEL[p.ruolo] ?? ''}</span></div>
              </a>
            );
          })}
        </Carousel>
      </div>
    </section>
  )}

  <!-- STAFF (anteprima): fondo chiaro con il motivo a palloni -->
  {staffPreview.length > 0 && (
    <section class="section fascia-staff">
      <div class="container">
        <div class="section-head between">
          <div><span class="eyebrow">Dietro le quinte</span><h2>Lo staff</h2></div>
          <a class="btn" href="/squadra/#staff">Tutto lo staff</a>
        </div>
        <Carousel etichetta="Staff e dirigenza" allinea="stretch">
          {staffPreview.map((m) => {
            const foto = img(m.foto, 300, 300);
            return (
              <div class="card member-mini">
                <div class="mm-ph">{foto ? <img src={foto} alt={m.nome} loading="lazy" /> : <div class="rp-empty" aria-hidden="true"></div>}</div>
                <div class="mm-info">
                  <strong>{m.nome}</strong>
                  <span class="tag" title={m.ruolo}>{primoRuolo(m.ruolo)}</span>
                </div>
              </div>
            );
          })}
        </Carousel>
      </div>
    </section>
  )}

  <!-- SPONSOR -->
  {(sponsor.length > 0 || mikasaLogo) && (
    <section class="section">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Insieme a noi</span><h2>I nostri partner</h2></div>
        {/* Ogni riga scorre nel verso opposto alla precedente */}
        {gruppiSponsor.map((g, i) => (
          <div class="spon-gruppo">
            <h3 class="spon-titolo">{g.label}</h3>
            <StrisciaSponsor etichetta={g.label} fissa={g.fissa}
              altezza={`${g.h}px`}
              direzione={i % 2 === 0 ? 'avanti' : 'indietro'}>
              {g.items.map((sp) => {
                // Senza logo resta il nome: gli si dà la stessa impronta
                // degli altri della riga, altrimenti sballa la gerarchia.
                const pronto = loghiPronti.get(sp._id);
                const misura = pronto ? misuraLogo(pronto.prop, g.h) : undefined;
                const inner = pronto
                  ? <img src={pronto.url} alt={sp.nome} loading="lazy" />
                  : <span class="sp-nome-piano">{sp.nome}</span>;
                return sp.url
                  ? <a href={sp.url} target="_blank" rel="noopener" class="sp-logo" title={sp.nome} style={misura}>{inner}</a>
                  : <div class="sp-logo" title={sp.nome} style={misura}>{inner}</div>;
              })}
            </StrisciaSponsor>
          </div>
        ))}

        {sponsorFinali.length > 0 && (
          <div class="spon-gruppo spon-finali">
            {sponsorFinali.map((f) => {
              const inner = f.logo
                ? <img src={f.logo} alt={f.nome} loading="lazy" />
                : <span class="sp-nome-piano">{f.nome}</span>;
              return (
                <div class="spon-finale">
                  <span class="spon-etichetta">{f.label}</span>
                  {f.url
                    ? <a href={f.url} target="_blank" rel="noopener" class="sp-logo" title={f.nome} style={f.misura}>{inner}</a>
                    : <div class="sp-logo" title={f.nome} style={f.misura}>{inner}</div>}
                </div>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )}
</Layout>

<style>
  /* Fasce colorate: lo sfondo è un'immagine già composta (sfumatura + motivo).
     Il colore pieno resta sotto come riserva se l'immagine non carica. */
  /* Una fascia colorata deve avere il proprio respiro sopra: la regola globale
     che azzera il margine fra sezioni consecutive vale per i fondi bianchi,
     dove lo spazio lo dà la sezione precedente. Qui resterebbe fuori dal colore. */
  .fascia, .fascia-staff { padding-top: clamp(40px, 7vw, 84px); }
  /* Dopo una fascia colorata la sezione bianca deve avere il proprio margine:
     il riempimento inferiore della fascia è colorato e appartiene alla fascia,
     quindi non fa da stacco per ciò che viene dopo. */
  .fascia + .section, .fascia-staff + .section, .campagna + .section { padding-top: clamp(40px, 7vw, 84px); }
  /* Ancorato in alto: col centro la fascia mostrava la parte di mezzo
     dell'immagine e partiva da un rosso più chiaro di quello del disegno. */
  .fascia { background-size: cover; background-position: top center; background-repeat: no-repeat; }
  /* Sezione staff: motivo a palloni ripetuto sul fondo chiaro.
     L'immagine è una griglia regolare, quindi si affianca senza stacchi. */
  .fascia-staff { background: var(--surface) url('/sfondi/staff.png') top left repeat; }
  /* Il file esportato di questa fascia è più chiaro di quanto si veda nel
     mockup (#A50C0F contro #760A0D): probabilmente in Figma ha sopra un velo
     che l'esportazione non ha incluso. Lo ricreo qui, misurato sul disegno.
     Quando arriverà l'esportazione corretta basterà togliere il primo strato. */
  .fascia-partite { background-color: #7E080D;
    background-image: linear-gradient(rgba(0,0,0,.28), rgba(0,0,0,.28)), url('/sfondi/calendario.jpg'); }
  .fascia .section-head h2, .fascia .section-head .eyebrow { color: #fff; }
  /* Pillola chiara sul fondo scuro */
  .fascia .btn.chiaro { background: #fff; border-color: transparent; color: var(--accent-deep); }
  .fascia .btn.chiaro:hover { background: #fff; color: var(--accent); }

  /* Apertura: notizia in evidenza a sinistra, prossima partita a destra */
  /* Stesso respiro di tutte le altre sezioni: il ritmo verticale è unico */
  .apertura-sezione { padding-top: clamp(40px, 7vw, 84px); }
  /* Due colonne solo se c'è la prossima partita: altrimenti la notizia
     occuperebbe 2/3 lasciando un vuoto a destra. */
  .apertura { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-items: start; }
  /* stretch: le due schede chiudono alla stessa altezza. Senza, quella della
     partita (più alta) lasciava la notizia "corta" e i bordi disallineati. */
  .apertura.con-partita { grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr); align-items: stretch; }
  @media (max-width: 1000px) { .apertura.con-partita { grid-template-columns: minmax(0, 1fr); } }
  .nm-cta { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; width: 100%; }
  .nm-cta .btn { justify-content: center; }
  .btn.live { background: var(--ink); color: #fff; border-color: transparent; }
  .btn.live:hover { background: #000; }
  .live-dot { width: .55rem; height: .55rem; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 0 0 rgba(255,59,59,.6); animation: livepulse 1.6s ease-out infinite; }
  @keyframes livepulse { 0% { box-shadow: 0 0 0 0 rgba(255,59,59,.6); } 70% { box-shadow: 0 0 0 7px rgba(255,59,59,0); } 100% { box-shadow: 0 0 0 0 rgba(255,59,59,0); } }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }
  .next-match { padding: 26px 24px; text-align: center; box-shadow: var(--shadow);
    display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .next-match .eyebrow { display: block; margin-bottom: 14px; }
  /* Nel mockup sono maiuscoli: così il condensato è coerente con la convenzione */
  .nm-team { font-size: 1.42rem; font-weight: 820; letter-spacing: 0; text-transform: uppercase; }
  .nm-vs { color: var(--ink-faint); font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; margin: 6px 0; font-weight: 700; }
  .nm-when { margin-top: 16px; font-weight: 600; color: var(--ink); }
  .nm-where { color: var(--ink-faint); font-size: .9rem; margin-top: 4px; }
  /* Nel mockup gli sponsor non hanno riquadri: solo il logo sullo sfondo.
     Misure e comportamento stanno in StrisciaSponsor. */

  /* Pallone ufficiale (Mikasa) */
  /* Gruppi di sponsor per categoria */
  .spon-gruppo + .spon-gruppo { margin-top: clamp(24px, 3.5vw, 38px); }
  /* Etichetta minuscola tutta maiuscola e spaziata: resta nel carattere
     del testo, il condensato dei titoli qui diventa illeggibile. */
  .spon-titolo { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  /* Ultima riga: media, ticketing, tecnico e pallone tutti insieme */
  .spon-finali { display: flex; flex-wrap: wrap; gap: 18px; padding-top: 4px; }
  .spon-finale { display: flex; flex-direction: column; gap: 7px; }
  /* Stesso trattamento dei titoli di livello qui sopra: sono etichette dello
     stesso tipo, e il condensato sotto i 13px non si legge più. */
  .spon-etichetta { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em;
    color: var(--ink-faint); font-weight: 700; }
  /* Stessa altezza dei "Partner", per coerenza con la riga sopra */
  .spon-finali { gap: clamp(26px, 4vw, 54px); align-items: flex-start; }
  /* Stessa altezza dei Partner: dopo quel livello non c'è più gerarchia.
     Le misure arrivano dalla pagina come --lh/--lw, calcolate sul logo già
     privo dei margini vuoti: prima questi tre restavano molto più piccoli
     degli altri pur avendo la stessa altezza impostata. */
  .spon-finali .sp-logo { height: var(--lh, 48px); width: var(--lw, auto);
    display: inline-flex; align-items: center; }
  .spon-finali .sp-logo img { height: 100%; width: 100%; object-fit: contain; display: block; }
  @media (max-width: 640px) {
    .spon-finali .sp-logo { height: calc(var(--lh, 48px) * .78); width: auto; }
    .spon-finali .sp-logo img { width: auto; }
  }


  /* Schede giocatore nel carosello */
  .rp-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: transform .14s ease, border-color .14s ease; }
  .rp-card:hover { transform: translateY(-3px); border-color: var(--ink-faint); }
  /* Sfumatura dietro al giocatore, presa dal mockup. Il colore pieno resta
     sotto come riserva. Si vede per intero solo con le foto scontornate:
     con una foto su fondo bianco resta coperta, senza rompere nulla. */
  .rp-ph { position: relative; aspect-ratio: 4 / 5; background: linear-gradient(180deg, #000000 0%, #4A0505 100%), #F1EDED; overflow: hidden;
    /* Riferimento per la misura del numero: così cresce con la scheda */
    container-type: inline-size; }
  .rp-ph img { width: 100%; height: 100%; object-fit: cover; }
  /* Foto mancante: segnaposto neutro. Lasciando vedere la sfumatura rossa
     della scheda, accanto alle foto ancora su fondo bianco sembrerebbe un
     errore invece di un posto vuoto. Da rivedere quando arriveranno gli
     scontorni e tutte le schede avranno lo stesso fondo. */
  .rp-empty { width: 100%; height: 100%; background: linear-gradient(180deg, var(--surface-2), var(--surface)); }
  /* Nel mockup il numero non è una targhetta ma una cifra grande e cava,
     in alto a destra, disegnata col solo contorno chiaro sopra allo sfondo
     scuro della foto. Non ruba spazio al volto e non va ritagliata. */
  .rp-num { position: absolute; top: -3px; right: 5%; pointer-events: none;
    font-family: var(--font-display); font-weight: 800; line-height: 1;
    font-size: 3.3rem; font-size: 28cqw;
    color: transparent; -webkit-text-stroke: 1.2px rgba(255, 255, 255, .5);
    font-variant-numeric: tabular-nums; }
  /* Senza il contorno del testo la cifra sparirebbe: lì torna piena, smorzata */
  @supports not (-webkit-text-stroke: 1px #000) {
    .rp-num { color: rgba(255, 255, 255, .3); }
  }
  .rp-info { padding: 10px 12px; display: flex; flex-direction: column; gap: 1px; }
  .rp-info strong { font-weight: 750; letter-spacing: -.01em; }

  /* Anteprima staff */
  .member-mini { display: flex; flex-direction: column; }
  /* Sfumatura dietro al giocatore, presa dal mockup. Il colore pieno resta
     sotto come riserva. Si vede per intero solo con le foto scontornate:
     con una foto su fondo bianco resta coperta, senza rompere nulla. */
  .mm-ph { aspect-ratio: 1 / 1; background: linear-gradient(180deg, #4A0505 0%, #F30404 100%), #F1EDED; overflow: hidden; }
