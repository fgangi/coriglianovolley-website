---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PartitaRow from '../../components/PartitaRow.astro';
import { sfetch, img, formatData, youtubeEmbed, pezziData } from '../../lib/sanity';
import { calendarioQuery, classificaQuery, settingsQuery } from '../../lib/queries';

const [partite, classifica, settings] = await Promise.all([
  sfetch<any[]>(calendarioQuery, {}, []),
  sfetch<any>(classificaQuery, {}, null),
  sfetch<any>(settingsQuery, {}, null),
]);
const prossime = partite.filter((m) => !m.giocata);
const giocate = partite.filter((m) => m.giocata).reverse();
const clImg = classifica?.modalita === 'immagine' ? img(classifica.immagine, 1000) : null;

// Prima della 1ª giornata non esiste una classifica: numerare le squadre
// suggerirebbe un ordine reale (e ci mostrerebbe ultimi senza aver giocato).
// In quel caso: elenco alfabetico, posizione sostituita da un trattino.
const righeCl: any[] = classifica?.righe ?? [];
// Basta un valore diverso da zero in una qualsiasi riga: così la nota sparisce
// anche se in redazione aggiornano solo i punti e dimenticano "Giocate".
const nonIniziato = righeCl.length > 0 &&
  righeCl.every((r: any) => !r.giocate && !r.vinte && !r.perse && !r.punti);
const righeOrdinate = nonIniziato
  ? [...righeCl].sort((a, b) => String(a.squadra ?? '').localeCompare(String(b.squadra ?? ''), 'it'))
  : righeCl;

// Diretta: priorità alla prossima partita con link YouTube, altrimenti canale generale
const matchDiretta = prossime.find((m) => m.direttaUrl) ?? null;
const direttaLink = matchDiretta?.direttaUrl ?? settings?.direttaUrl ?? null;
const direttaEmbed = youtubeEmbed(direttaLink);
const direttaMatch = matchDiretta ?? prossime[0] ?? null;

/** Raggruppa le partite per mese, mantenendo l'ordine ricevuto. */
function perMese(elenco: any[]) {
  const gruppi: { titolo: string; partite: any[] }[] = [];
  for (const p of elenco) {
    const d = pezziData(p.data);
    const titolo = d?.meseAnno ?? 'Da definire';
    const ultimo = gruppi[gruppi.length - 1];
    if (ultimo && ultimo.titolo === titolo) ultimo.partite.push(p);
    else gruppi.push({ titolo, partite: [p] });
  }
  return gruppi;
}
const prossimePerMese = perMese(prossime);
const giocatePerMese = perMese(giocate);
---
<Layout title="Partite & classifica">
  <PageHero eyebrow="Campo" title="Partite & classifica" lead="Calendario, risultati e classifica aggiornata del girone." />

  <section class="section">
    <div class="container">
      <!-- PROSSIME -->
      <div class="section-head"><span class="eyebrow">In arrivo</span><h2>Prossime partite</h2></div>
      {prossime.length ? (
        prossimePerMese.map((g) => (
          <div class="mese-gruppo">
            <h3 class="mese-titolo">{g.titolo}</h3>
            <div class="grid cols-2">{g.partite.map((m) => <PartitaRow m={m} />)}</div>
          </div>
        ))
      ) : (
        <div class="empty"><strong>Nessuna partita in calendario</strong>Le partite inserite nel pannello appariranno qui.</div>
      )}
    </div>
  </section>

  <!-- DIRETTA -->
  <section class="section" id="diretta" style="scroll-margin-top: 90px;">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Live</span><h2>Diretta</h2></div>
      {direttaEmbed ? (
        <div class="diretta-grid">
          <div class="player">
            <iframe src={direttaEmbed} title="Diretta streaming" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
          {direttaMatch && (
            <aside class="diretta-info card">
              <span class="tag">{direttaMatch.competizione ?? 'Serie A3'}{direttaMatch.giornata ? ` · ${direttaMatch.giornata}` : ''}</span>
              <div class="di-teams">
                <strong>{direttaMatch.dove === 'casa' ? (settings?.nomeSquadra ?? 'Corigliano') : direttaMatch.avversario}</strong>
                <span class="di-vs">vs</span>
                <strong>{direttaMatch.dove === 'casa' ? direttaMatch.avversario : (settings?.nomeSquadra ?? 'Corigliano')}</strong>
              </div>
              <span class="tag">{formatData(direttaMatch.data, true)}</span>
              <a class="btn" href="/squadra/#roster">Vedi la rosa →</a>
            </aside>
          )}
        </div>
      ) : direttaLink ? (
        <div class="diretta-cta card">
          <div>
            <strong>Diretta streaming</strong>
            <p class="muted" style="margin-top:4px;">La partita sarà trasmessa in diretta sul canale ufficiale.</p>
          </div>
          <a class="btn primary" href={direttaLink} target="_blank" rel="noopener">Guarda la diretta →</a>
        </div>
      ) : (
        <div class="empty"><strong>Nessuna diretta programmata</strong>Quando una partita sarà trasmessa in streaming, il player comparirà qui.</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- RISULTATI -->
      <div class="section-head"><span class="eyebrow">Archivio</span><h2>Risultati</h2></div>
      {giocate.length ? (
        giocatePerMese.map((g) => (
          <div class="mese-gruppo">
            <h3 class="mese-titolo">{g.titolo}</h3>
            <div class="grid cols-2">{g.partite.map((m) => <PartitaRow m={m} />)}</div>
          </div>
        ))
      ) : (
        <div class="empty"><strong>Ancora nessun risultato</strong>I risultati appariranno qui dopo le prime giornate.</div>
      )}
    </div>
  </section>

  <section class="section" id="classifica" style="scroll-margin-top: 90px;">
    <div class="container">
      <!-- CLASSIFICA -->
      <div class="section-head between">
        <div><span class="eyebrow">Girone</span><h2>Classifica</h2></div>
        {classifica?.aggiornataAl && <span class="tag">Aggiornata al {formatData(classifica.aggiornataAl)}</span>}
      </div>

      {!classifica ? (
        <div class="empty"><strong>Classifica non ancora pubblicata</strong>Verrà aggiornata dalla redazione (immagine o tabella) con il link ufficiale della Lega.</div>
      ) : clImg ? (
        <figure class="cl-img"><img src={clImg} alt="Classifica Serie A3" /></figure>
      ) : righeOrdinate.length ? (
        <>
          {nonIniziato && (
            <p class="cl-nota">Il campionato non è ancora iniziato: le squadre del girone sono elencate in ordine alfabetico.</p>
          )}
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Squadra</th><th>Punti</th><th>G</th><th>V</th><th>P</th></tr></thead>
            <tbody>
              {righeOrdinate.map((r: any, i: number) => (
                <tr class={/corigliano/i.test(r.squadra ?? '') ? 'ours' : ''}>
                  <td class="tabnums">{nonIniziato ? '—' : i + 1}</td>
                  <td>{r.squadra}</td>
                  <td class="tabnums"><strong>{r.punti ?? 0}</strong></td>
                  <td class="tabnums">{r.giocate ?? '—'}</td>
                  <td class="tabnums">{r.vinte ?? '—'}</td>
                  <td class="tabnums">{r.perse ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </>
      ) : (
        <div class="empty"><strong>Classifica in aggiornamento</strong></div>
      )}

      {classifica?.linkUfficiale && (
        <a class="btn" style="margin-top:16px;" href={classifica.linkUfficiale} target="_blank" rel="noopener">
          Classifica ufficiale su Legavolley →
        </a>
      )}
    </div>
  </section>
</Layout>
<style>
  .mese-gruppo + .mese-gruppo { margin-top: clamp(24px, 3.5vw, 38px); }
  .mese-titolo { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .cl-nota { font-size: .86rem; color: var(--ink-faint); margin: 0 0 14px; }
  .cl-img { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; min-width: 480px; }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); }
  thead th { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-faint); background: var(--surface-2); }
  tbody tr:last-child td { border-bottom: none; }
  tr.ours { background: var(--accent-tint); }
  tr.ours td { color: var(--accent-strong); font-weight: 650; }

  /* Diretta */
  .diretta-grid { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  @media (max-width: 820px) { .diretta-grid { grid-template-columns: minmax(0, 1fr); } }
  .player { position: relative; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .diretta-info { padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .di-teams { display: flex; flex-direction: column; gap: 2px; font-size: 1.15rem; }
  .di-teams .di-vs { font-size: .75rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .1em; font-weight: 700; }
  .diretta-cta { padding: 22px 24px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .diretta-cta strong { font-size: 1.1rem; }
</style>
