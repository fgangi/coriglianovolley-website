---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PartitaRow from '../../components/PartitaRow.astro';
import TabelloneTorneo from '../../components/TabelloneTorneo.astro';
import StrisciaDiretta from '../../components/StrisciaDiretta.astro';
import { sfetch, img, formatData, pezziData } from '../../lib/sanity';
import { calendarioQuery, classificaQuery, settingsQuery, torneoQuery } from '../../lib/queries';
import { logoRifilato } from '../../lib/loghi';

const [partite, classifica, settings, avversarie, torneo] = await Promise.all([
  sfetch<any[]>(calendarioQuery, {}, []),
  sfetch<any>(classificaQuery, {}, null),
  sfetch<any>(settingsQuery, {}, null),
  sfetch<any[]>('*[_type == "squadraAvversaria" && defined(logo)]{nome, logo}', {}, []),
  sfetch<any>(torneoQuery, {}, null),
]);
const prossime = partite.filter((m) => !m.giocata);
const giocate = partite.filter((m) => m.giocata).reverse();
const clImg = classifica?.modalita === 'immagine' ? img(classifica.immagine, 1000) : null;

// Prima della 1ª giornata non esiste una classifica: numerare le squadre
// suggerirebbe un ordine reale (e ci mostrerebbe ultimi senza aver giocato).
// In quel caso: elenco alfabetico, posizione sostituita da un trattino.
const righeCl: any[] = classifica?.righe ?? [];
// Basta un valore diverso da zero in una qualsiasi riga: così la nota sparisce
// anche se in redazione aggiornano solo i punti e dimenticano "Giocate".
const nonIniziato = righeCl.length > 0 &&
  righeCl.every((r: any) => !r.giocate && !r.vinte && !r.perse && !r.punti);
const righeOrdinate = nonIniziato
  ? [...righeCl].sort((a, b) => String(a.squadra ?? '').localeCompare(String(b.squadra ?? ''), 'it'))
  : righeCl;

// Stemmi in classifica. Le righe sono testo libero, quindi lo stemma si trova
// cercando la squadra avversaria con lo stesso nome (ignorando maiuscole,
// accenti e spazi); per noi si usa il logo della società. I margini vuoti dei
// file vengono tolti, altrimenti alcuni stemmi sembrerebbero la metà degli altri.
const PID = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const DS = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const norm = (t: string) => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');
const logoSquadra = new Map<string, string>();
for (const r of righeCl) {
  const n = norm(r.squadra);
  if (!n || logoSquadra.has(n)) continue;
  const fonte = /corigliano/.test(n)
    ? settings?.logo
    : (avversarie.find((a) => norm(a.nome) === n) ?? avversarie.find((a) => n.includes(norm(a.nome)) || norm(a.nome).includes(n)))?.logo;
  const pronto = fonte ? await logoRifilato(fonte, PID, DS, 96) : null;
  if (pronto) logoSquadra.set(n, pronto.url);
}

// Diretta: il link del canale YouTube (una partita può averne uno suo)
const direttaLink = prossime.find((m) => m.direttaUrl)?.direttaUrl ?? settings?.direttaUrl ?? null;

/** Raggruppa le partite per mese, mantenendo l'ordine ricevuto. */
function perMese(elenco: any[]) {
  const gruppi: { titolo: string; partite: any[] }[] = [];
  for (const p of elenco) {
    const d = pezziData(p.data);
    const titolo = d?.meseAnno ?? 'Da definire';
    const ultimo = gruppi[gruppi.length - 1];
    if (ultimo && ultimo.titolo === titolo) ultimo.partite.push(p);
    else gruppi.push({ titolo, partite: [p] });
  }
  return gruppi;
}
const prossimePerMese = perMese(prossime);
const giocatePerMese = perMese(giocate);
const logoUrl = img(settings?.logo, 200);
---
<Layout title="Partite e classifica" description="Calendario, risultati e classifica della Corigliano Volley nel campionato di Serie A3 Credem Banca, girone Blu.">
  <PageHero eyebrow="Campo" title="Partite e classifica" lead="Calendario, risultati e classifica aggiornata del girone." />

  {/* Diretta: striscia subito sotto il titolo, dove la trova chi arriva dal menu */}
  {direttaLink && (
    <div id="diretta">
      <StrisciaDiretta url={direttaLink} partite={prossime} torneo={torneo} nomeSquadra={settings?.nomeSquadra ?? 'Corigliano Volley'} />
    </div>
  )}

  <!-- TORNEO: sezione temporanea, compare solo con il torneo attivo nel pannello -->
  {torneo && (
    <section class="section">
      <div class="container">
        <div class="section-head" id="torneo">
          <span class="eyebrow">{torneo.edizione ? `Precampionato · ${torneo.edizione}` : 'Precampionato'}</span>
          <h2>{torneo.nome}</h2>
        </div>
        <TabelloneTorneo torneo={torneo} logoNostro={img(settings?.logo, 160)} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <!-- PROSSIME -->
      <div class="section-head" id="calendario"><span class="eyebrow">In arrivo</span><h2>Calendario</h2></div>
      {prossime.length ? (
        prossimePerMese.map((g) => (
          <div class="mese-gruppo">
            <h3 class="mese-titolo">{g.titolo}</h3>
            <div class="grid cols-2 griglia-partite">{g.partite.map((m) => <PartitaRow m={m} logoNostro={logoUrl} />)}</div>
          </div>
        ))
      ) : (
        <div class="empty"><strong>Nessuna partita in calendario</strong>Le partite inserite nel pannello appariranno qui.</div>
      )}
    </div>
  </section>

  <!-- RISULTATI: compare dalla prima partita giocata, come in home -->
  {giocate.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head" id="risultati"><span class="eyebrow">Archivio</span><h2>Risultati</h2></div>
      {giocatePerMese.map((g) => (
        <div class="mese-gruppo">
          <h3 class="mese-titolo">{g.titolo}</h3>
          <div class="grid cols-2 griglia-partite">{g.partite.map((m) => <PartitaRow m={m} logoNostro={logoUrl} />)}</div>
        </div>
      ))}
    </div>
  </section>
  )}

  <section class="section">
    <div class="container">
      <!-- CLASSIFICA -->
      <div class="section-head between" id="classifica">
        <div><span class="eyebrow">Girone</span><h2>Classifica</h2></div>
        {classifica?.aggiornataAl && <span class="tag">Aggiornata al {formatData(classifica.aggiornataAl)}</span>}
      </div>

      {!classifica ? (
        <div class="empty"><strong>Classifica non ancora pubblicata</strong>Verrà aggiornata dalla redazione (immagine o tabella) con il link ufficiale della Lega.</div>
      ) : clImg ? (
        <figure class="cl-img"><img src={clImg} alt="Classifica Serie A3" /></figure>
      ) : righeOrdinate.length ? (
        <>
          {nonIniziato && (
            <p class="cl-nota">Il campionato non è ancora iniziato: le squadre del girone sono elencate in ordine alfabetico.</p>
          )}
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Squadra</th><th>Punti</th><th>G</th><th>V</th><th>P</th></tr></thead>
            <tbody>
              {righeOrdinate.map((r: any, i: number) => (
                <tr class={/corigliano/i.test(r.squadra ?? '') ? 'ours' : ''}>
                  <td class="tabnums">{nonIniziato ? '—' : i + 1}</td>
                  <td>
                    <span class="cl-squadra">
                      {logoSquadra.get(norm(r.squadra))
                        ? <img class="cl-stemma" src={logoSquadra.get(norm(r.squadra))} alt="" loading="lazy" />
                        : <span class="cl-stemma" aria-hidden="true"></span>}
                      {r.squadra}
                    </span>
                  </td>
                  <td class="tabnums"><strong>{r.punti ?? 0}</strong></td>
                  <td class="tabnums">{r.giocate ?? '—'}</td>
                  <td class="tabnums">{r.vinte ?? '—'}</td>
                  <td class="tabnums">{r.perse ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </>
      ) : (
        <div class="empty"><strong>Classifica in aggiornamento</strong></div>
      )}

      {classifica?.linkUfficiale && (
        <a class="btn" style="margin-top:16px;" href={classifica.linkUfficiale} target="_blank" rel="noopener">
          Classifica ufficiale su Legavolley →
        </a>
      )}
    </div>
  </section>
</Layout>
<style>
  /* Sotto i 900px le schede su due colonne erano larghe 290-370px: i nomi
     lunghi ("BCC Tecbus Castellana Grotte") finivano su 3-4 righe e l'etichetta
     Casa/Trasferta scendeva sotto la giornata. Una scheda per riga. */
  @media (max-width: 899px) { .griglia-partite { grid-template-columns: minmax(0, 1fr); } }
  .mese-gruppo + .mese-gruppo { margin-top: clamp(24px, 3.5vw, 38px); }
  /* Etichetta minuscola tutta maiuscola e spaziata: resta nel carattere
     del testo, il condensato dei titoli qui diventa illeggibile. */
  .mese-titolo { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .cl-nota { font-size: .86rem; color: var(--ink-faint); margin: 0 0 14px; }
  .cl-img { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; min-width: 480px; }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); vertical-align: middle; }
  /* Intestazioni leggibili: a .72rem il condensato spariva. In maiuscolo
     condensato un corpo appena sopra quello del testo delle righe regge
     il confronto visivo con i nomi in Inter. */
  thead th { font-size: 1.05rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft); }
  /* Stemma e nome sulla stessa riga; lo spazio dello stemma resta anche se
     manca, così i nomi partono tutti allo stesso punto. */
  .cl-squadra { display: inline-flex; align-items: center; gap: 12px; }
  .cl-stemma { width: 32px; height: 32px; object-fit: contain; flex: none; display: block; }
  tbody tr:last-child td { border-bottom: none; }
  tr.ours { background: var(--accent-tint); }
  /* Su schermi stretti la tabella scorre in orizzontale: posizione e squadra
     restano ferme a sinistra, così si sa sempre di chi sono i numeri.
     Le celle ferme hanno bisogno di un fondo pieno, altrimenti i numeri che
     scorrono si vedrebbero sotto; lo prendono dalla riga. */
  tbody tr { background: var(--surface); }
  th:nth-child(1), td:nth-child(1) { position: sticky; left: 0; z-index: 1; width: 52px; min-width: 52px; background: inherit; }
  th:nth-child(2), td:nth-child(2) { position: sticky; left: 52px; z-index: 1; background: inherit;
    box-shadow: inset -1px 0 0 var(--line-soft); }
  thead tr { background: var(--surface-2); }
  @media (max-width: 639px) {
    th, td { padding: 10px 12px; }
    th:nth-child(1), td:nth-child(1) { width: 40px; min-width: 40px; }
    th:nth-child(2), td:nth-child(2) { left: 40px; }
    /* La tabella prende la larghezza del contenuto invece di allargare la
       colonna squadra fino a riempire i 480px minimi: così la parte ferma
       resta stretta e resta spazio per vedere punti e partite scorrendo.
       I nomi lunghi vanno a capo. */
    table { width: max-content; min-width: 100%; }
    td:nth-child(2) .cl-squadra { width: 128px; line-height: 1.2; font-size: .92rem; gap: 8px; }
    .cl-stemma { width: 26px; height: 26px; }
  }
  tr.ours td { color: var(--accent-strong); font-weight: 650; }

</style>
