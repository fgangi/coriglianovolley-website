---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { sfetch, img } from '../lib/sanity';
import { sponsorQuery, settingsQuery } from '../lib/queries';

const sponsor = await sfetch<any[]>(sponsorQuery, {}, []);
const settings = await sfetch<any>(settingsQuery, {}, null);
const mikasaLogo = img(settings?.loghiLega?.mikasaLogo, 320);
const mikasaUrl = settings?.loghiLega?.mikasaUrl;
const LIV: Record<string, string> = { main: 'Main sponsor', gold: 'Gold', silver: 'Silver', partner: 'Partner' };
const ordine = ['main', 'gold', 'silver', 'partner'];
const gruppi = ordine
  .map((l) => ({ livello: l, label: LIV[l], items: sponsor.filter((s) => s.livello === l) }))
  .filter((g) => g.items.length > 0);
---
<Layout title="Sponsor">
  <PageHero eyebrow="Insieme a noi" title="Sponsor & partner" lead="Chi sostiene la squadra e rende possibile il nostro percorso." />
  <section class="section">
    <div class="container">
      {sponsor.length === 0 ? (
        <div class="empty"><strong>Sponsor non ancora inseriti</strong>I partner aggiunti nel pannello appariranno qui, raggruppati per livello.</div>
      ) : (
        gruppi.map((g) => (
          <div class="liv-group">
            <h2 class="liv-title">{g.label}</h2>
            <div class="sponsor-grid" data-livello={g.livello}>
              {g.items.map((sp) => {
                const logo = img(sp.logo, 300);
                const inner = logo ? <img src={logo} alt={sp.nome} loading="lazy" /> : <span>{sp.nome}</span>;
                return sp.url
                  ? <a href={sp.url} target="_blank" rel="noopener" class="sp">{inner}</a>
                  : <div class="sp">{inner}</div>;
              })}
            </div>
          </div>
        ))
      )}

      {mikasaLogo && (
        <div class="liv-group">
          <h2 class="liv-title">Pallone ufficiale</h2>
          <div class="sponsor-grid" data-livello="main">
            {mikasaUrl ? (
              <a href={mikasaUrl} target="_blank" rel="noopener" class="sp"><img src={mikasaLogo} alt="Mikasa" loading="lazy" /></a>
            ) : (
              <div class="sp"><img src={mikasaLogo} alt="Mikasa" loading="lazy" /></div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
<style>
  .liv-group + .liv-group { margin-top: clamp(28px, 4vw, 44px); }
  .liv-title { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 20px; }
  .sponsor-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .sponsor-grid[data-livello="main"] { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 760px) { .sponsor-grid, .sponsor-grid[data-livello="main"] { grid-template-columns: repeat(2, 1fr); } }
  .sp { height: 110px; display: grid; place-items: center; padding: 20px; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius); transition: transform .12s ease; }
  .sp:hover { transform: translateY(-2px); }
  .sp img { max-height: 64px; width: auto; object-fit: contain; }
  .sp span { font-weight: 700; color: var(--ink-soft); }
</style>
