---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { sfetch, img } from '../lib/sanity';
import { sponsorQuery, settingsQuery } from '../lib/queries';
import { logoRifilato } from '../lib/loghi';

const sponsor = await sfetch<any[]>(sponsorQuery, {}, []);
const settings = await sfetch<any>(settingsQuery, {}, null);
const mikasaLogo = img(settings?.loghiLega?.mikasaLogo, 320);
const mikasaUrl = settings?.loghiLega?.mikasaUrl;
// Sezioni della pagina, nell'ordine in cui compaiono.
// Una sezione può raccogliere più livelli, se servisse.
// Stessa gerarchia di dimensioni della home: qui però le file restano ferme,
// perché questa è la pagina dell'elenco completo e ogni marchio deve restare
// sempre visibile, non passare ogni tanto.
const SEZIONI: { label: string; livelli: string[]; h: number }[] = [
  { label: 'Main sponsor', livelli: ['main'], h: 92 },
  { label: 'Gold sponsor', livelli: ['gold'], h: 78 },
  { label: 'Silver sponsor', livelli: ['silver'], h: 66 },
  { label: 'Bronze sponsor', livelli: ['bronze'], h: 58 },
  { label: 'Partner', livelli: ['partner'], h: 52 },
  { label: 'Media partner', livelli: ['media'], h: 52 },
  { label: 'Ticketing partner', livelli: ['ticketing'], h: 52 },
  { label: 'Sponsor tecnico', livelli: ['tecnico'], h: 52 },
];
const gruppi = SEZIONI
  .map((s) => ({ ...s, items: sponsor.filter((x) => s.livelli.includes(x.livello)) }))
  .filter((g) => g.items.length > 0);

/**
 * Misura del logo. Criterio: STESSA ALTEZZA per tutti i loghi dello stesso
 * livello, che è ciò che l'occhio legge come "ordinato" in una fila.
 * La pari superficie, provata prima, dava risultati opposti: con proporzioni
 * che vanno da 0,8 a 6,8 un logo allungato finiva alto 30px e uno quadrato 86.
 * Un tetto alla larghezza evita che i pochi casi estremi dominino la riga:
 * solo quelli scendono sotto l'altezza comune.
 */
function misuraLogo(prop: number, altezza: number): string {
  let h = altezza;
  let w = prop * h;
  const wMax = altezza * 4.6;
  if (w > wMax) { w = wMax; h = w / prop; }
  return `height:${Math.round(h)}px;width:${Math.round(w)}px`;
}

const PID = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const DS = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const loghiPronti = new Map<string, { url: string; prop: number }>();
for (const g of gruppi) {
  for (const sp of g.items) {
    const r = await logoRifilato(sp.logo, PID, DS);
    if (r) loghiPronti.set(sp._id, r);
  }
}
---
<Layout title="Sponsor">
  <PageHero eyebrow="Insieme a noi" title="Sponsor e partner" lead="Chi sostiene la squadra e rende possibile il nostro percorso." />
  <section class="section">
    <div class="container">
      {sponsor.length === 0 ? (
        <div class="empty"><strong>Sponsor non ancora inseriti</strong>I partner aggiunti nel pannello appariranno qui, raggruppati per livello.</div>
      ) : (
        gruppi.map((g) => (
          <div class="liv-group">
            <h2 class="liv-title">{g.label}</h2>
            <div class="sponsor-grid">
              {g.items.map((sp) => {
                const pronto = loghiPronti.get(sp._id);
                const misura = pronto ? misuraLogo(pronto.prop, g.h) : undefined;
                const inner = pronto
                  ? <img src={pronto.url} alt={sp.nome} loading="lazy" />
                  : <span class="sp-nome-piano">{sp.nome}</span>;
                return sp.url
                  ? <a href={sp.url} target="_blank" rel="noopener" class="sp-logo" title={sp.nome} style={misura}>{inner}</a>
                  : <div class="sp-logo" title={sp.nome} style={misura}>{inner}</div>;
              })}
            </div>
          </div>
        ))
      )}

      {mikasaLogo && (
        <div class="liv-group">
          <h2 class="liv-title">Pallone ufficiale</h2>
          <div class="sponsor-grid">
              {mikasaUrl ? (
              <a href={mikasaUrl} target="_blank" rel="noopener" class="sp-logo" title="Mikasa" style="height:68px">
                <img src={mikasaLogo} alt="Mikasa" loading="lazy" />
              </a>
            ) : (
              <div class="sp-logo" title="Mikasa" style="height:68px"><img src={mikasaLogo} alt="Mikasa" loading="lazy" /></div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
<style>
  .liv-group + .liv-group { margin-top: clamp(30px, 4.4vw, 50px); }
  .liv-title { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 22px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }

  /* Stessa estetica della home: nessun riquadro, solo il logo sul fondo.
     Qui però la fila non scorre: è l'elenco completo, e ogni marchio deve
     restare sempre visibile invece di passare ogni tanto. */
  .sponsor-grid { display: flex; flex-wrap: wrap; align-items: center;
    gap: clamp(30px, 4.5vw, 70px) clamp(34px, 5vw, 76px); }
  .sp-logo { flex: none; display: inline-flex; align-items: center; justify-content: center;
    max-width: 100%; transition: transform .14s ease; }
  .sp-logo img { height: 100%; width: 100%; object-fit: contain; display: block; }
  a.sp-logo:hover { transform: translateY(-3px); }
  .sp-nome-piano { font-weight: 700; color: var(--ink-soft); font-size: .95rem;
    line-height: 1.2; text-align: center; max-width: 170px; }
  @media (max-width: 640px) { .sponsor-grid { gap: 26px 30px; } }
</style>
