---
// Font self-hosted (nessuna chiamata a server esterni).
// Versione "variabile": un solo file copre tutti i pesi da 100 a 900.
import '@fontsource-variable/archivo';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sfetch, img } from '../lib/sanity';
import { settingsQuery } from '../lib/queries';
// Barra per simulare stati diversi: esiste solo durante lo sviluppo
import AnteprimaStati from '../components/AnteprimaStati.astro';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

// Stile della transizione fra pagine: 'zoom' | 'slide' | 'dissolvenza'
const ANIMAZIONE = 'dissolvenza';

const settings = await sfetch<any>(settingsQuery, {}, null);
const nomeSquadra = settings?.nomeSquadra ?? 'Corigliano Volley';
const logoUrl = img(settings?.logo, 200);
const legaCredemLogo = img(settings?.loghiLega?.legaCredemLogo, 400);
const legaCredemUrl = settings?.loghiLega?.legaCredemUrl;
// Stessa condizione della pagina: la voce di menù segue la sezione reale
const iscrizioniAperte = settings?.iscrizioni?.aperte !== false && !!settings?.iscrizioni?.moduloUrl;
const pageTitle = title ? `${title} – ${nomeSquadra}` : `${nomeSquadra} – Serie A3`;
const desc = description ?? `Sito ufficiale ${nomeSquadra}, Serie A3 maschile: news, calendario, risultati, roster e settore giovanile.`;
---
<!doctype html>
<html lang="it" data-anim={ANIMAZIONE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Transizioni fluide tra le pagine invece del ricaricamento secco */}
    <ClientRouter />
  </head>
  <body>
    <Header nomeSquadra={nomeSquadra} bigliettiUrl={settings?.bigliettiUrl} abbonamentiUrl={settings?.abbonamentiUrl} iscrizioniAperte={iscrizioniAperte} logoUrl={logoUrl} legaCredemLogo={legaCredemLogo} legaCredemUrl={legaCredemUrl} />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
    {import.meta.env.DEV && <AnteprimaStati />}

  </body>
</html>
