---
import { img } from '../lib/sanity';

/**
 * Griglia di foto che si aprono a schermo intero. Si scorre con le frecce
 * (anche da tastiera), col dito, e si chiude con Esc, la X o toccando fuori.
 * Usa <dialog>: il browser si occupa da solo di bloccare la pagina sotto e di
 * riportare il fuoco sulla miniatura alla chiusura.
 */
interface Props { foto: any[]; titolo: string }
const { foto, titolo } = Astro.props;
const elenco = foto
  .filter((f) => f?.asset)
  .map((f, i) => ({
    mini: img(f, 600, 450),
    grande: img(f, 1800),
    alt: f.didascalia || `${titolo}, foto ${i + 1}`,
    didascalia: f.didascalia ?? '',
  }));
---
{elenco.length > 0 && (
  <div class="galleria" data-galleria>
    <ul class="gal-griglia">
      {elenco.map((f, i) => (
        <li>
          <button type="button" class="gal-mini" data-indice={i} data-grande={f.grande} data-didascalia={f.didascalia}
            aria-label={`Apri la foto ${i + 1} di ${elenco.length}${f.didascalia ? `: ${f.didascalia}` : ''}`}>
            <img src={f.mini} alt={f.alt} loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
    <dialog class="gal-dialogo" aria-label={`Foto: ${titolo}`}>
      <figure class="gal-figura">
        <img class="gal-img" alt="" />
        <figcaption class="gal-didascalia"><span class="gal-testo"></span><span class="gal-conta tabnums"></span></figcaption>
      </figure>
      <button type="button" class="gal-btn gal-chiudi" aria-label="Chiudi">✕</button>
      <button type="button" class="gal-btn gal-prec" aria-label="Foto precedente">‹</button>
      <button type="button" class="gal-btn gal-succ" aria-label="Foto successiva">›</button>
    </dialog>
  </div>
)}

<style>
  .gal-griglia { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 639px) { .gal-griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } }
  .gal-mini { display: block; width: 100%; padding: 0; border: 0; background: var(--surface-2); cursor: zoom-in;
    aspect-ratio: 4 / 3; overflow: hidden; border-radius: 10px; }
  .gal-mini img { width: 100%; height: 100%; object-fit: cover; transition: transform .2s ease; }
  .gal-mini:hover img { transform: scale(1.04); }
  .gal-mini:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .gal-dialogo { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(12, 10, 10, .94); color: #fff; }
  .gal-dialogo::backdrop { background: rgba(12, 10, 10, .94); }
  .gal-dialogo[open] { display: grid; place-items: center; }
  .gal-figura { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px;
    max-width: min(100vw - 120px, 1600px); }
  .gal-img { max-width: 100%; max-height: calc(100dvh - 120px); width: auto; height: auto; object-fit: contain; user-select: none; }
  .gal-didascalia { display: flex; gap: 16px; font-size: .92rem; color: rgba(255, 255, 255, .82); }
  .gal-conta { color: rgba(255, 255, 255, .55); }
  /* Bersagli da 48px: si usano anche col dito */
  .gal-btn { position: absolute; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .25);
    background: rgba(255, 255, 255, .08); color: #fff; font-size: 1.6rem; line-height: 1; display: grid; place-items: center;
    cursor: pointer; }
  .gal-btn:hover { background: rgba(255, 255, 255, .18); }
  .gal-btn:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .gal-chiudi { top: 16px; right: 16px; font-size: 1.1rem; }
  .gal-prec { left: 16px; top: 50%; transform: translateY(-50%); }
  .gal-succ { right: 16px; top: 50%; transform: translateY(-50%); }
  .gal-dialogo[data-una] .gal-prec, .gal-dialogo[data-una] .gal-succ { display: none; }
  @media (max-width: 639px) {
    .gal-figura { max-width: 100vw; }
    .gal-prec, .gal-succ { top: auto; bottom: 16px; transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const avvia = () => {
      document.querySelectorAll('[data-galleria]').forEach((g) => {
        if (g.dataset.pronta) return;
        g.dataset.pronta = '1';
        const mini = [...g.querySelectorAll('.gal-mini')];
        const dlg = g.querySelector('.gal-dialogo');
        const im = dlg.querySelector('.gal-img');
        const testo = dlg.querySelector('.gal-testo');
        const conta = dlg.querySelector('.gal-conta');
        let i = 0;
        if (mini.length < 2) dlg.dataset.una = '1';
        const mostra = (n) => {
          i = (n + mini.length) % mini.length;
          const b = mini[i];
          im.src = b.dataset.grande;
          im.alt = b.querySelector('img').alt;
          testo.textContent = b.dataset.didascalia || '';
          conta.textContent = mini.length > 1 ? `${i + 1} / ${mini.length}` : '';
          // La successiva si scarica in anticipo: lo scorrimento non resta vuoto
          const dopo = mini[(i + 1) % mini.length];
          if (dopo) new Image().src = dopo.dataset.grande;
        };
        mini.forEach((b, n) => { b.onclick = () => { mostra(n); dlg.showModal(); }; });
        dlg.querySelector('.gal-chiudi').onclick = () => dlg.close();
        dlg.querySelector('.gal-prec').onclick = () => mostra(i - 1);
        dlg.querySelector('.gal-succ').onclick = () => mostra(i + 1);
        // Un tocco sullo sfondo (non sulla foto né sui pulsanti) chiude
        // (dopo uno scorrimento col dito il browser manda anche un click: si ignora)
        let scorso = false;
        dlg.addEventListener('click', (e) => { if (scorso) { scorso = false; return; } if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') mostra(i - 1);
          if (e.key === 'ArrowRight') mostra(i + 1);
        });
        let x0 = null;
        dlg.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
        dlg.addEventListener('pointerup', (e) => {
          if (x0 == null) return;
          const dx = e.clientX - x0; x0 = null;
          if (Math.abs(dx) > 50) { scorso = true; mostra(i + (dx < 0 ? 1 : -1)); }
        });
      });
    };
    avvia();
    document.addEventListener('astro:page-load', avvia);
  })();
</script>
