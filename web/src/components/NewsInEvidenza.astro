---
import { img, formatData, posizione } from '../lib/sanity';

/** Scheda grande dell'articolo in evidenza, usata in home e nella pagina News. */
interface Props { item: any; }
const { item } = Astro.props;

const cover = img(item.copertina, 1100);
const pos = posizione(item.posizioneAnteprima);
---
<a class="featured card" href={`/news/${item.slug}`}>
  <div class="f-media">
    {cover
      ? <img src={cover} alt={item.titolo} style={`object-position:${pos}`} />
      : <div class="thumb-ph" aria-hidden="true"></div>}
  </div>
  <div class="f-body">
    <span class="pill">In evidenza</span>
    <span class="tag">{formatData(item.data)}</span>
    <h3>{item.titolo}</h3>
    {item.estratto && <p>{item.estratto}</p>}
    <span class="more">Leggi l'articolo →</span>
  </div>
</a>

<style>
  .featured { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: stretch;
    transition: transform .14s ease, border-color .14s ease; }
  .featured:hover { transform: translateY(-3px); border-color: var(--ink-faint); }
  /* aspect-ratio dà al riquadro le stesse proporzioni delle schede news;
     align-self: stretch gli fa comunque riempire tutta l'altezza della scheda,
     così non resta mai una striscia vuota sotto l'immagine. */
  /* width:100% ancora la larghezza alla colonna: senza, quando lo stretch
     rende l'altezza definita, aspect-ratio ricalcola la larghezza dall'altezza
     e l'immagine finisce sopra al testo. */
  .f-media { position: relative; background: var(--surface-2); overflow: hidden;
    width: 100%; aspect-ratio: 16 / 10; align-self: stretch; }
  .f-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .f-media .thumb-ph { width: 100%; height: 100%;
    background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 12px, var(--surface) 12px, var(--surface) 24px); }
  /* Padding e corpo del titolo contenuti: in home la colonna del testo è
     stretta (la scheda divide lo spazio con "prossima partita"). */
  .f-body { padding: clamp(18px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; justify-content: center; }
  /* Titolo ed estratto limitati: il testo resta più basso dell'immagine */
  .f-body h3 { font-size: clamp(1.2rem, 1.9vw, 1.6rem); font-weight: 800; letter-spacing: -.015em;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .f-body p { font-size: 1rem;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .f-body .more { margin-top: 6px; font-weight: 700; color: var(--accent); }
  @media (max-width: 900px) { .featured { grid-template-columns: 1fr; } }
</style>
