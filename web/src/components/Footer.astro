---
import { img, mapEmbedSrc } from '../lib/sanity';
interface Props { settings: any; }
const { settings } = Astro.props;
const s = settings ?? {};
const logoUrl = img(s.logo, 200);
const social = s.social ?? {};
const anno = new Date().getFullYear();
const nome = s.nomeSquadra ?? 'Corigliano Volley';
const iniziali = nome.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
// Mappa: accetta codice iframe, URL di embed, coordinate o indirizzo (vedi mapEmbedSrc)
const mapSrc = mapEmbedSrc(s.mappaPosizione || s.indirizzo);
// Loghi obbligatori Lega, replicati in fondo alla pagina
const lega = s.loghiLega ?? {};
const legaCredemLogo = img(lega.legaCredemLogo, 600);
const mikasaLogo = img(lega.mikasaLogo, 400);

const icons: Record<string, string> = {
  instagram: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.43.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.43.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.43-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.12 1.38C1.36 2.67.95 3.34.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.47 1.38 2.13.66.66 1.33 1.07 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.8-.31 1.47-.72 2.13-1.38.66-.66 1.07-1.33 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.8-.72-1.47-1.38-2.13-.66-.66-1.33-1.07-2.13-1.38-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4z"/><circle cx="18.41" cy="5.59" r="1.44"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.92-1.95 1.87V12h3.32l-.53 3.47h-2.79v8.38A12 12 0 0 0 24 12z"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.6l5.24 6.93zM17.61 20.64h2.04L6.48 3.24H4.3z"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.3v13.35a2.42 2.42 0 1 1-2.42-2.42c.13 0 .26.01.38.03v-3.35a5.8 5.8 0 0 0-.38-.01A5.77 5.77 0 1 0 15.6 14V8.36a7.55 7.55 0 0 0 4.4 1.41V6.46a4.28 4.28 0 0 1-3.4-.64z"/></svg>',
};
const labels: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', youtube: 'YouTube', x: 'X', tiktok: 'TikTok' };
const socialLinks = ['instagram', 'facebook', 'youtube', 'x', 'tiktok']
  .map((k) => ({ k, url: social[k] }))
  .filter((it) => !!it.url);
// Elenco telefoni (con supporto al vecchio campo singolo)
const telefoni: { etichetta?: string; numero: string }[] =
  (s.telefoni?.length ? s.telefoni : s.telefono ? [{ numero: s.telefono }] : []) ?? [];
const telHref = (n: string) => 'tel:' + n.replace(/[^\d+]/g, '');
---
<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <!-- Brand + social -->
      <div>
        <a class="brand" href="/" style="color:#fff;">
          {logoUrl ? <img class="mark-img" src={logoUrl} alt={`Logo ${nome}`} /> : <span class="mark">{iniziali}</span>}
          <span class="brand-name">{nome}</span>
        </a>
        <p class="foot-desc">{s.stagione ? `Stagione ${s.stagione} · ` : ''}Serie A3.</p>

        {(legaCredemLogo || mikasaLogo) && (
          <div class="brand-partners">
            {legaCredemLogo && (
              lega.legaCredemUrl
                ? <a href={lega.legaCredemUrl} target="_blank" rel="noopener" aria-label="Lega Pallavolo Serie A · Credem Banca"><img src={legaCredemLogo} alt="Lega Pallavolo Serie A · Credem Banca" /></a>
                : <img src={legaCredemLogo} alt="Lega Pallavolo Serie A · Credem Banca" />
            )}
            {mikasaLogo && (
              lega.mikasaUrl
                ? <a href={lega.mikasaUrl} target="_blank" rel="noopener" aria-label="Mikasa"><img src={mikasaLogo} alt="Mikasa" /></a>
                : <img src={mikasaLogo} alt="Mikasa" />
            )}
          </div>
        )}

        {socialLinks.length > 0 && (
          <div class="social-icons">
            {socialLinks.map((it) => (
              <a href={it.url} target="_blank" rel="noopener" aria-label={labels[it.k]}>
                <Fragment set:html={icons[it.k]} />
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Naviga -->
      <div>
        <h4>Naviga</h4>
        <div class="fnav">
          <a href="/squadra">Squadra</a>
          <a href="/partite">Partite &amp; classifica</a>
          <a href="/news">News</a>
          <a href="/settore-giovanile">Settore giovanile</a>
          <a href="/gallery">Gallery</a>
          <a href="/sponsor">Sponsor</a>
          {s.bigliettiUrl && <a href={s.bigliettiUrl} target="_blank" rel="noopener">Biglietti</a>}
        </div>
      </div>

      <!-- Dove siamo + contatti + mappa -->
      <div>
        <h4>Dove siamo</h4>
        <div class="fnav">
          {s.indirizzo && <span style="color:#C9C2C2; white-space:pre-line;">{s.indirizzo}</span>}
          {s.email && <a href={`mailto:${s.email}`}>{s.email}</a>}
          {telefoni.map((t) => (
            <a href={telHref(t.numero)}>{t.etichetta ? `${t.etichetta}: ${t.numero}` : t.numero}</a>
          ))}
        </div>
        {mapSrc && (
          <div class="foot-map">
            <iframe src={mapSrc} loading="lazy" title={`Mappa ${s.indirizzo ?? 'sede'}`} allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        )}
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {anno} {nome}</span>
      <span>Sviluppato da <a href="https://github.com/fgangi" target="_blank" rel="noopener">Francesco Gangi</a></span>
    </div>
  </div>
</footer>
