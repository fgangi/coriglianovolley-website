---
import { img, posizione } from '../lib/sanity';
import { dateEvento, inProgramma, TIPI } from '../lib/eventi';

/**
 * Scheda di un evento nell'elenco: stessa forma delle news, così la sezione
 * si legge come il resto del sito. In alto sulla foto il tipo (organizzato o
 * partecipazione) e, se è futuro, "In programma".
 */
interface Props { item: any }
const { item } = Astro.props;
const cover = img(item.copertina, 700);
const pos = posizione(item.posizioneAnteprima);
const futuro = inProgramma(item);
---
<a class="card evento-card" href={`/eventi/${item.slug}/`}>
  <div class="thumb">
    {cover ? <img src={cover} alt={item.titolo} loading="lazy" style={`object-position:${pos}`} /> : <div class="thumb-ph" aria-hidden="true"></div>}
    <span class="etichette">
      {futuro && <span class="pill futuro">In programma</span>}
      <span class="pill tipo">{TIPI[item.tipo] ?? 'Evento'}</span>
    </span>
  </div>
  <div class="body">
    <span class="tag">{[dateEvento(item.dataInizio, item.dataFine), item.categoria].filter(Boolean).join(' · ')}</span>
    <h3>{item.titolo}</h3>
    {item.luogo && <span class="luogo">{item.luogo}</span>}
    {item.estratto && <p>{item.estratto}</p>}
    <span class="more">Scopri →</span>
  </div>
</a>
<style>
  .evento-card { display: flex; flex-direction: column; transition: transform .14s ease, border-color .14s ease; }
  .evento-card:hover { transform: translateY(-3px); border-color: var(--ink-faint); }
  .thumb { position: relative; aspect-ratio: 16 / 10; background: var(--surface-2); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-ph { width: 100%; height: 100%;
    background: repeating-linear-gradient(135deg, var(--surface-2), var(--surface-2) 12px, var(--surface) 12px, var(--surface) 24px); }
  .etichette { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; flex-wrap: wrap; gap: 6px; }
  .pill.tipo { background: rgba(20, 16, 17, .78); color: #fff; }
  .pill.futuro { background: var(--accent); color: var(--accent-ink); }
  .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .body h3 { margin: 2px 0; }
  .luogo { font-size: .88rem; color: var(--ink-soft); font-weight: 600; }
  .body p { font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .more { margin-top: auto; padding-top: 10px; font-size: .88rem; font-weight: 650; color: var(--accent); }
</style>
