---
import SchedaStaff from './SchedaStaff.astro';
interface Props {
  staff: any[];
  /** Aree da mostrare (in ordine). Se omesso, le mostra tutte. */
  aree?: string[];
  /** Testo dello stato vuoto. */
  vuoto?: string;
}
const { staff, aree, vuoto } = Astro.props;

const AREE: Record<string, string> = {
  tecnico: 'Staff tecnico', medico: 'Staff medico',
  presidenza: 'Presidenza', dirigenza: 'Dirigenza',
};
const ordine = aree ?? ['tecnico', 'medico', 'presidenza', 'dirigenza'];
const gruppi = ordine
  .map((a) => ({ label: AREE[a], membri: staff.filter((m) => (m.area ?? 'tecnico') === a) }))
  .filter((g) => g.membri.length > 0);
---
{gruppi.length === 0 ? (
  <div class="empty"><strong>{vuoto ?? 'Staff non ancora inserito'}</strong>I membri aggiunti nel pannello appariranno qui.</div>
) : (
  gruppi.map((g) => (
    <div class="area-group">
      {/* Con un solo gruppo il titolo ripeterebbe quello della sezione */}
      {gruppi.length > 1 && <h3 class="area-title">{g.label}</h3>}
      <div class="grid griglia-schede">
        {g.membri.map((m) => <SchedaStaff m={m} completo />)}
      </div>
    </div>
  ))
)}
<style>
  .area-group + .area-group { margin-top: clamp(30px, 5vw, 52px); }
  .area-title { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  /* La scheda è la stessa della home: stile e misure stanno in SchedaStaff */
  /* Tre standard: PC 4 colonne, tablet (640–1023px) 3, telefono 2. A una
     colonna sul telefono ogni scheda era alta ~650px e la pagina superava i
     16.000px; a due colonne resta leggibile, come i caroselli della home. */
  .griglia-schede { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1023px) { .griglia-schede { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .griglia-schede { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>
