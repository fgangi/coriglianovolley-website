---
interface Props {
  nomeSquadra: string;
  bigliettiUrl?: string;
  logoUrl?: string | null;
  legaCredemLogo?: string | null;
  legaCredemUrl?: string;
}
const { nomeSquadra, bigliettiUrl, logoUrl, legaCredemLogo, legaCredemUrl } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

type Item = { href: string; label: string; children?: { href: string; label: string }[] };
const nav: Item[] = [
  { href: '/', label: 'Home' },
  {
    href: '/squadra', label: 'Squadra',
    children: [
      { href: '/squadra', label: 'La squadra' },
      { href: '/squadra#roster', label: 'Roster' },
      { href: '/squadra#staff', label: 'Staff' },
      { href: '/squadra#presidenza', label: 'Presidenza' },
      { href: '/squadra#dirigenza', label: 'Dirigenza' },
      { href: '/squadra/chi-siamo', label: 'Chi siamo' },
    ],
  },
  {
    href: '/partite', label: 'Partite',
    children: [
      { href: '/partite', label: 'Calendario & risultati' },
      { href: '/partite#classifica', label: 'Classifica' },
      { href: '/partite#diretta', label: 'Diretta' },
    ],
  },
  { href: '/news', label: 'News' },
  { href: '/settore-giovanile', label: 'Settore giovanile' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/sponsor', label: 'Sponsor' },
  { href: '/contatti', label: 'Contatti' },
];

const isActive = (href: string) => {
  const clean = href.split('#')[0];
  if (clean === '/') return path === '/';
  return path === clean || path.startsWith(clean + '/');
};
const iniziali = nomeSquadra.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<header class="site-header">
  <div class="container bar">
    <div class="brand-cluster">
      <a class="brand" href="/">
        {logoUrl
          ? <img class="mark-img" src={logoUrl} alt={`Logo ${nomeSquadra}`} />
          : <span class="mark">{iniziali}</span>}
        <span class="brand-name">{nomeSquadra}</span>
      </a>
      {legaCredemLogo && (
        <>
          <span class="brand-sep" aria-hidden="true"></span>
          {legaCredemUrl
            ? <a class="credem" href={legaCredemUrl} target="_blank" rel="noopener" aria-label="Lega Pallavolo Serie A · Credem Banca"><img src={legaCredemLogo} alt="Lega Pallavolo Serie A · Credem Banca" /></a>
            : <span class="credem"><img src={legaCredemLogo} alt="Lega Pallavolo Serie A · Credem Banca" /></span>}
        </>
      )}
    </div>

    <button class="nav-toggle" aria-label="Apri menu" aria-expanded="false" data-nav-toggle>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <nav class="mainnav" data-nav aria-label="Navigazione principale">
      {nav.map((item) => item.children ? (
        <div class="mainnav-item has-sub" data-sub data-open="false">
          <button
            class="mainnav-link mainnav-trigger"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            data-active={isActive(item.href) ? 'true' : undefined}
            data-trigger
          >
            {item.label}
            <svg class="caret-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="submenu">
            {item.children.map((c) => (
              <a href={c.href} aria-current={path === c.href && !c.href.includes('#') ? 'page' : undefined}>{c.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a class="mainnav-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      {bigliettiUrl && <a class="mainnav-link cta" href={bigliettiUrl} target="_blank" rel="noopener">Biglietti</a>}
    </nav>
  </div>
</header>
<script>
  const navToggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  const items = Array.from(document.querySelectorAll('[data-sub]'));

  /** Chiude tutte le tendine, tranne quella indicata. */
  function closeSubmenus(except) {
    items.forEach((item) => {
      if (item === except) return;
      item.setAttribute('data-open', 'false');
      item.querySelector('[data-trigger]')?.setAttribute('aria-expanded', 'false');
    });
  }

  function closeMobileNav() {
    nav?.setAttribute('data-open', 'false');
    navToggle?.setAttribute('aria-expanded', 'false');
  }

  navToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!open));
    navToggle.setAttribute('aria-expanded', String(!open));
    if (open) closeSubmenus();
  });

  // Le voci con tendina si aprono al click (niente hover: evita chiusure
  // accidentali passando dal bottone al menu, e click che finiscono sotto).
  items.forEach((item) => {
    const trigger = item.querySelector('[data-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const open = item.getAttribute('data-open') === 'true';
      closeSubmenus(item);
      item.setAttribute('data-open', String(!open));
      trigger.setAttribute('aria-expanded', String(!open));
    });
  });

  // Click fuori dal menu: chiude tutto.
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest('.mainnav') || e.target.closest('[data-nav-toggle]')) return;
    closeSubmenus();
    closeMobileNav();
  });

  // Esc chiude; il tasto riporta il focus al trigger aperto.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const aperto = items.find((i) => i.getAttribute('data-open') === 'true');
    closeSubmenus();
    closeMobileNav();
    (aperto?.querySelector('[data-trigger]'))?.focus();
  });
</script>
