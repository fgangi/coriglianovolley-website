---
interface Props { eyebrow?: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="container narrow">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
<style>
  .page-hero { padding: clamp(40px, 7vw, 80px) 0 clamp(18px, 3vw, 30px); border-bottom: 1px solid var(--line); background: var(--surface); }
  /* Colonna flex: l'occhiello è un <span> inline e il suo margine verticale
     verrebbe ignorato dal browser. Fra occhiello e titolo la stessa distanza
     delle intestazioni di sezione (--stacco-occhiello); il sottotitolo sta più
     staccato, perché è testo di lettura e non fa parte del titolo. */
  .page-hero .container { display: flex; flex-direction: column; align-items: flex-start; gap: var(--stacco-occhiello); }
  .page-hero .eyebrow { margin: 0; }
  .page-hero h1 { margin: 0; }
  .page-hero .lead { max-width: 60ch; margin: 10px 0 0; }
</style>
