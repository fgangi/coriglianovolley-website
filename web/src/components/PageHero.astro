---
interface Props { eyebrow?: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="container narrow">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
<style>
  .page-hero { padding: clamp(40px, 7vw, 80px) 0 clamp(18px, 3vw, 30px); border-bottom: 1px solid var(--line); background: var(--surface); }
  .page-hero h1 { margin: 0 0 10px; }
  .page-hero .lead { max-width: 60ch; }
</style>
