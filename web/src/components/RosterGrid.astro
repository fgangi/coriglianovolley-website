---
import SchedaGiocatore from './SchedaGiocatore.astro';
interface Props { roster: any[]; }
const { roster } = Astro.props;

const RUOLI: Record<string, string> = {
  palleggiatore: 'Palleggiatori', opposto: 'Opposti', schiacciatore: 'Schiacciatori',
  centrale: 'Centrali', libero: 'Liberi',
};
const ordine = ['palleggiatore', 'opposto', 'schiacciatore', 'centrale', 'libero'];
const gruppi = ordine
  .map((r) => ({ label: RUOLI[r], giocatori: roster.filter((g) => g.ruolo === r) }))
  .filter((g) => g.giocatori.length > 0);
---
{roster.length === 0 ? (
  <div class="empty"><strong>Roster non ancora inserito</strong>I giocatori aggiunti nel pannello appariranno qui, raggruppati per ruolo.</div>
) : (
  gruppi.map((g) => (
    <div class="ruolo-group">
      <h3 class="ruolo-title">{g.label}</h3>
      <div class="grid griglia-schede">
        {g.giocatori.map((p) => <SchedaGiocatore p={p} dettagli />)}
      </div>
    </div>
  ))
)}
<style>
  .ruolo-group + .ruolo-group { margin-top: clamp(30px, 5vw, 52px); }
  .ruolo-title { font-size: .95rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 700;
    margin: 0 0 20px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  /* La scheda è la stessa della home: stile e misure stanno in SchedaGiocatore */
  /* Tre standard: PC 4 colonne, tablet (640–1023px) 3, telefono 2. A una
     colonna sul telefono ogni scheda era alta ~650px e la pagina superava i
     16.000px; a due colonne resta leggibile, come i caroselli della home. */
  .griglia-schede { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1023px) { .griglia-schede { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .griglia-schede { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>
