---
import { pezziData, img } from '../lib/sanity';

interface Props { m: any; logoNostro?: string | null }
const { m, logoNostro = null } = Astro.props;

const casa = m.dove === 'casa';
const nostra = 'Corigliano Volley';
// Il nome viene dalla squadra collegata; il testo libero resta come riserva
const avversaria = m.avversaria?.nome ?? m.avversario ?? '';
const logoAvv = m.avversaria?.logo ? img(m.avversaria.logo, 220) : null;
const sinistra = casa ? nostra : avversaria;
const destra = casa ? avversaria : nostra;
const logoSx = casa ? logoNostro : logoAvv;
const logoDx = casa ? logoAvv : logoNostro;
const conLoghi = Boolean(logoSx || logoDx);
const giocata = m.giocata && m.setCasa != null && m.setTrasferta != null;
const win = giocata && ((casa && m.setCasa > m.setTrasferta) || (!casa && m.setTrasferta > m.setCasa));
const d = pezziData(m.data);
// Il luogo si divide all'ultima virgola: "Palasport di Galatone" e "Galatone (LE)".
// Quando non sta su una riga va a capo solo lì, mai a metà del nome.
const luogo = String(m.luogo ?? '').trim();
const virgola = luogo.lastIndexOf(',');
const luogoParti = virgola > 0 ? [luogo.slice(0, virgola + 1), luogo.slice(virgola + 1).trim()] : [luogo];
---
<div class={`match ${giocata ? 'played' : 'upcoming'}`}>
  <!-- Tessera con la data, in evidenza a sinistra -->
  <div class="data-tile" aria-hidden="true">
    <span class="dt-giorno">{d?.giorno ?? '--'}</span>
    <span class="dt-mese">{d?.mese ?? ''}</span>
    {!giocata && d?.ora && <span class="dt-ora">{d.ora}</span>}
  </div>

  <div class="corpo">
    <div class="meta">
      {m.giornata && <span class="giornata">{m.giornata}</span>}
      <span class={`dove ${casa ? 'in-casa' : 'fuori'}`}>{casa ? 'Casa' : 'Trasferta'}</span>
    </div>

    <div class={`teams ${conLoghi ? 'con-loghi' : ''}`}>
      <div class="lato">
        {logoSx && <img class="stemma" src={logoSx} alt="" loading="lazy" />}
        <span class={`team ${casa ? 'ours' : ''}`}>{sinistra}</span>
      </div>
      {giocata
        ? <span class={`score ${win ? 'win' : 'loss'}`}>{m.setCasa}<span class="sep">–</span>{m.setTrasferta}</span>
        : <span class="vs">vs</span>}
      <div class="lato">
        {logoDx && <img class="stemma" src={logoDx} alt="" loading="lazy" />}
        <span class={`team ${!casa ? 'ours' : ''}`}>{destra}</span>
      </div>
    </div>

    {giocata && m.parziali && <div class="extra tabnums">{m.parziali}</div>}

    {m.reportUrl && <a class="report" href={m.reportUrl} target="_blank" rel="noopener">Report ufficiale →</a>}
  </div>

  {/* Seconda riga della griglia, nella colonna della partita: così si centra
      sotto "squadra vs squadra" e resta in fondo anche se la data è più alta. */}
  {!giocata && m.luogo && (
    <div class="extra luogo">
      <span class="luogo-testo">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        {luogoParti.map((parte, i) => <>{i > 0 && ' '}<span class={i > 0 ? 'luogo-citta' : 'luogo-nome'}>{parte}</span></>)}
      </span>
    </div>
  )}
</div>

<style>
  /* Nel mockup la scheda ha il contorno nero sottile su tutti i lati, non il
     grigio chiaro delle altre schede del sito: è ciò che la fa staccare dal
     fondo rosso. La linguetta a sinistra è lo stesso nero, più spessa. */
  /* column-gap separa data e corpo; row-gap resta minimo, altrimenti la riga
     del luogo (che occupa tutta la larghezza) stacca la scheda in due. */
  .match { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; row-gap: 2px;
    background: var(--surface); border: 1px solid var(--black); border-radius: var(--radius);
    padding: 15px 16px; align-items: start; }
  .match.upcoming { border-left-width: 4px; }

  /* Data: nel mockup non ha riquadro, sta direttamente sulla scheda ed è
     grande. Senza la tessera resta più larghezza ai nomi delle squadre. */
  .data-tile { display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    min-width: 58px; padding: 0; background: none; border: 0; }
  /* Misure standard indicate dalla designer: giorno 40px, mese 25px, ora 18px */
  .dt-giorno { font-size: 2.5rem; font-weight: 900; line-height: 1; letter-spacing: -.01em;
    font-variant-numeric: tabular-nums; color: var(--accent-strong); }
  .match.played .dt-giorno { color: var(--ink); }
  .dt-mese { font-size: 1.5625rem; font-weight: 750; letter-spacing: .02em; color: var(--ink-faint);
    line-height: 1; margin-top: 2px; text-transform: uppercase; }
  .dt-ora { font-size: 1.125rem; font-weight: 650; color: var(--ink-faint); margin-top: 6px;
    font-variant-numeric: tabular-nums; }

  .corpo { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .giornata { font-size: .84rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    color: var(--accent-strong); background: var(--accent-tint); padding: .22rem .5rem; border-radius: 999px; }
  /* Casa / Trasferta come etichetta, leggibile anche senza emoji */
  .dove { font-size: .84rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    padding: .22rem .5rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-soft); }
  .dove.in-casa { color: var(--ink); background: var(--surface-2); border-color: transparent; }
  .dove.fuori { color: var(--ink-faint); }

  .teams { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: 6px; }
  /* Con gli stemmi i nomi vanno sotto al logo e centrati, come nel mockup */
  .lato { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; text-align: center; }
  .teams:not(.con-loghi) .lato:first-child { align-items: flex-start; text-align: left; }
  .teams:not(.con-loghi) .lato:last-child { align-items: flex-end; text-align: right; }
  .stemma { height: 52px; width: auto; max-width: 100%; object-fit: contain; display: block; }
  .team { font-weight: 700; font-size: .95rem; line-height: 1.25; }
  .team.ours { color: var(--accent); }
  .teams.con-loghi .vs, .teams.con-loghi .score { align-self: center; margin-top: 18px; }
  .vs { font-size: .74rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
  .score { font-weight: 850; font-size: 1.45rem; font-variant-numeric: tabular-nums; }
  .score .sep { margin: 0 .28rem; color: var(--ink-faint); font-weight: 500; }
  .score.win { color: var(--accent); }
  .extra { font-size: .84rem; color: var(--ink-faint); }
  /* Riga del luogo: etichetta, quindi condensato maiuscolo con l'icona.
     Sta staccata in fondo alla scheda, non appiccicata ai nomi delle squadre,
     e centrata sulla colonna della partita (sotto "squadra vs squadra"), non
     sull'intera scheda: la data a sinistra non conta per il centro. */
  .luogo { grid-column: 2; display: block; text-align: center;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em;
    font-size: .88rem; font-weight: 700; line-height: 1.3; margin-top: 18px; }
  /* Testo in linea con l'icona davanti: su due righe l'icona resta accanto
     alla prima invece di galleggiare a metà fra le due. */
  .luogo svg { display: inline-block; vertical-align: -2px; margin-right: 5px; }
  /* La città ("Galatone (LE)") non si spezza mai: se non c'è posto passa
     intera alla riga sotto, quindi la riga va a capo dopo la virgola. Il nome
     del palazzetto va a capo al suo interno solo se da solo è più largo della
     scheda, invece di uscirne. */
  .luogo-citta { white-space: nowrap; }
  .report { font-size: .82rem; font-weight: 650; color: var(--accent); }

  @media (max-width: 420px) {
    .match { column-gap: 10px; row-gap: 2px; padding: 14px; }
    .data-tile { min-width: 54px; padding: 7px 8px; }
    .dt-giorno { font-size: 2rem; }
    .dt-mese { font-size: 1.25rem; }
    .dt-ora { font-size: 1rem; }
    .team { font-size: .92rem; }
  }
</style>
