---
import { pezziData } from '../lib/sanity';

interface Props { m: any; }
const { m } = Astro.props;

const casa = m.dove === 'casa';
const nostra = 'Corigliano Volley';
const sinistra = casa ? nostra : m.avversario;
const destra = casa ? m.avversario : nostra;
const giocata = m.giocata && m.setCasa != null && m.setTrasferta != null;
const win = giocata && ((casa && m.setCasa > m.setTrasferta) || (!casa && m.setTrasferta > m.setCasa));
const d = pezziData(m.data);
---
<div class={`match ${giocata ? 'played' : 'upcoming'}`}>
  <!-- Tessera con la data, in evidenza a sinistra -->
  <div class="data-tile" aria-hidden="true">
    <span class="dt-giorno">{d?.giorno ?? '--'}</span>
    <span class="dt-mese">{d?.mese ?? ''}</span>
    {!giocata && d?.ora && <span class="dt-ora">{d.ora}</span>}
  </div>

  <div class="corpo">
    <div class="meta">
      {m.giornata && <span class="giornata">{m.giornata}</span>}
      <span class={`dove ${casa ? 'in-casa' : 'fuori'}`}>{casa ? 'Casa' : 'Trasferta'}</span>
    </div>

    <div class="teams">
      <span class={`team ${casa ? 'ours' : ''}`}>{sinistra}</span>
      {giocata
        ? <span class={`score ${win ? 'win' : 'loss'}`}>{m.setCasa}<span class="sep">–</span>{m.setTrasferta}</span>
        : <span class="vs">vs</span>}
      <span class={`team right ${!casa ? 'ours' : ''}`}>{destra}</span>
    </div>

    {giocata && m.parziali && <div class="extra tabnums">{m.parziali}</div>}
    {!giocata && m.luogo && <div class="extra">{m.luogo}</div>}
    {m.reportUrl && <a class="report" href={m.reportUrl} target="_blank" rel="noopener">Report ufficiale →</a>}
  </div>
</div>

<style>
  .match { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px 18px; align-items: start; }
  .match.upcoming { border-left: 3px solid var(--accent); }

  /* Tessera data */
  .data-tile { display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-width: 62px; padding: 8px 10px; border-radius: 10px;
    background: var(--surface-2); border: 1px solid var(--line); }
  .match.upcoming .data-tile { background: var(--accent-tint); border-color: transparent; }
  .dt-giorno { font-size: 1.6rem; font-weight: 850; line-height: 1; letter-spacing: -.02em;
    font-variant-numeric: tabular-nums; color: var(--ink); }
  .match.upcoming .dt-giorno { color: var(--accent-strong); }
  .dt-mese { font-size: .68rem; font-weight: 750; letter-spacing: .1em; color: var(--ink-faint); margin-top: 2px; }
  .dt-ora { font-size: .72rem; font-weight: 650; color: var(--ink-soft); margin-top: 5px;
    font-variant-numeric: tabular-nums; }

  .corpo { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .giornata { font-size: .7rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase;
    color: var(--accent-strong); background: var(--accent-tint); padding: .22rem .5rem; border-radius: 999px; }
  /* Casa / Trasferta come etichetta, leggibile anche senza emoji */
  .dove { font-size: .68rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase;
    padding: .22rem .5rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-soft); }
  .dove.in-casa { color: var(--ink); background: var(--surface-2); border-color: transparent; }
  .dove.fuori { color: var(--ink-faint); }

  .teams { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; }
  .team { font-weight: 700; font-size: 1rem; }
  .team.right { text-align: right; }
  .team.ours { color: var(--accent); }
  .vs { font-size: .74rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
  .score { font-weight: 850; font-size: 1.45rem; font-variant-numeric: tabular-nums; }
  .score .sep { margin: 0 .28rem; color: var(--ink-faint); font-weight: 500; }
  .score.win { color: var(--accent); }
  .extra { font-size: .84rem; color: var(--ink-faint); }
  .report { font-size: .82rem; font-weight: 650; color: var(--accent); }

  @media (max-width: 420px) {
    .match { gap: 12px; padding: 14px; }
    .data-tile { min-width: 54px; padding: 7px 8px; }
    .dt-giorno { font-size: 1.35rem; }
    .team { font-size: .92rem; }
  }
</style>
